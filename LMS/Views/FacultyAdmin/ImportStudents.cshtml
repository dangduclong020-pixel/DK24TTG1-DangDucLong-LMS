@{
    ViewData["Title"] = "Import Sinh viên từ Excel";
    Layout = "~/Views/Shared/_FacultyLayout.cshtml";
    var facultyName = ViewBag.FacultyName as string;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-file-excel"></i> Import Sinh viên từ Excel
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Hướng dẫn -->
                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle"></i> Hướng dẫn sử dụng:</h6>
                        <ol class="mb-0">
                            <li>Tải file Excel mẫu về và điền thông tin sinh viên</li>
                            <li>File Excel cần có các cột theo thứ tự: <strong>Mã sinh viên, Họ tên, Email, Số điện thoại, Lớp hành chính, Mã khoa, Khoa, Chuyên ngành</strong></li>
                            <li>Dòng đầu tiên là tiêu đề, dữ liệu bắt đầu từ dòng thứ 2</li>
                            <li>Các trường bắt buộc: Mã SV, Họ tên, Email</li>
                            <li>Mật khẩu mặc định của sinh viên là: <code>123456</code></li>
                            <li><strong class="text-danger">LƯU Ý:</strong> Cột "Chuyên ngành" phải điền <strong>chính xác</strong> tên chuyên ngành thuộc khoa <strong>@ViewBag.FacultyName</strong> (xem danh sách bên dưới)</li>
                            <li>Nếu không điền hoặc điền sai, hệ thống sẽ tự động phân đều vào các chuyên ngành của khoa</li>
                        </ol>
                    </div>
                    
                    @if (ViewBag.Departments != null && ((List<LMS.Models.Department>)ViewBag.Departments).Any())
                    {
                        <div class="alert alert-warning mb-4">
                            <h6><i class="fas fa-list"></i> Danh sách chuyên ngành trong khoa @ViewBag.FacultyName:</h6>
                            <ul class="mb-0">
                                @foreach (var dept in (List<LMS.Models.Department>)ViewBag.Departments)
                                {
                                    <li><strong>@dept.Name</strong> @if(!string.IsNullOrEmpty(dept.Code)){<text>(Mã: @dept.Code)</text>}</li>
                                }
                            </ul>
                            <small class="text-muted mt-2 d-block"><i class="fas fa-info-circle"></i> Hãy copy chính xác tên chuyên ngành ở trên vào file Excel của bạn.</small>
                        </div>
                    }

                    <!-- Nút tải file mẫu -->
                    <div class="mb-4">
                        <a href="@Url.Action("DownloadImportTemplate", "FacultyAdmin")" class="btn btn-primary">
                            <i class="fas fa-download"></i> Tải file Excel mẫu
                        </a>
                        <small class="text-muted ms-2">Hoặc tạo file Excel theo định dạng hướng dẫn ở trên</small>
                    </div>

                    <!-- Form upload -->
                    <form asp-action="ImportStudents" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Chọn lớp hành chính (tùy chọn)</label>
                                <select name="administrativeClassId" class="form-select">
                                    <option value="">-- Không chọn (dựa vào Mã lớp trong Excel) --</option>
                                    @if (ViewBag.AdministrativeClasses != null)
                                    {
                                        @foreach (var item in ViewBag.AdministrativeClasses as SelectList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                                <div class="form-text">
                                    Nếu chọn lớp, tất cả sinh viên trong file sẽ được thêm vào lớp này
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">File Excel <span class="text-danger">*</span></label>
                                <input type="file" name="excelFile" class="form-control" accept=".xlsx,.xls" required />
                                <div class="form-text">
                                    Chỉ chấp nhận file .xlsx hoặc .xls
                                </div>
                            </div>
                        </div>

                        <hr>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-upload"></i> Import sinh viên
                            </button>
                            <a href="@Url.Action("StudentManagement", "FacultyAdmin")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng định dạng Excel mẫu -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-table"></i> Ví dụ định dạng file Excel</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm">
                            <thead class="table-primary">
                                <tr>
                                    <th>Mã sinh viên</th>
                                    <th>Họ tên</th>
                                    <th>Email</th>
                                    <th>Số điện thoại</th>
                                    <th>Lớp hành chính</th>
                                    <th>Khoa</th>
                                    <th>Chuyên ngành</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>SV001</td>
                                    <td>Nguyễn Văn An</td>
                                    <td>an.nguyen@student.lms.edu.vn</td>
                                    <td>0901234567</td>
                                    <td>CNTT2021A</td>
                                    <td>Khoa Công nghệ Thông tin</td>
                                    <td>Công nghệ Phần mềm</td>
                                </tr>
                                <tr>
                                    <td>SV002</td>
                                    <td>Trần Thị Bình</td>
                                    <td>binh.tran@student.lms.edu.vn</td>
                                    <td>0912345678</td>
                                    <td>CNTT2021A</td>
                                    <td>Khoa Công nghệ Thông tin</td>
                                    <td>Hệ thống Thông tin</td>
                                </tr>
                                <tr>
                                    <td>SV003</td>
                                    <td>Lê Văn Cường</td>
                                    <td>cuong.le@student.lms.edu.vn</td>
                                    <td>0923456789</td>
                                    <td>CNTT2021B</td>
                                    <td>Khoa Công nghệ Thông tin</td>
                                    <td>Khoa học Máy tính</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="alert alert-warning mt-3">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Lưu ý:</strong> Chuyên ngành phải điền đúng tên trong hệ thống. Nếu bỏ trống, hệ thống sẽ tự động phân đều.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị tên file khi chọn
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            var fileName = e.target.files[0]?.name;
            if (fileName) {
                var fileExt = fileName.split('.').pop().toLowerCase();
                if (fileExt !== 'xlsx' && fileExt !== 'xls') {
                    alert('Vui lòng chọn file Excel (.xlsx hoặc .xls)');
                    e.target.value = '';
                }
            }
        });
    </script>
}
