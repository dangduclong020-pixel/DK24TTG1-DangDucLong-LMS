@model LMS.Models.AdministrativeClass

@{
    ViewData["Title"] = "Tạo lớp hành chính mới";
    Layout = "~/Views/Shared/_FacultyLayout.cshtml";
    var facultyName = ViewBag.FacultyName as string;
    var userName = ViewBag.UserName as string;
    var currentYear = DateTime.Now.Year;
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="fas fa-plus-circle"></i> Tạo lớp hành chính mới</h2>
            <p class="text-muted">Tạo lớp hành chính cho @facultyName</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fas fa-edit"></i> Thông tin lớp hành chính</h5>
        </div>
        <div class="card-body">
            <form asp-action="CreateAdministrativeClass" method="post">
                @Html.AntiForgeryToken()
                
                <div class="row">
                    <!-- Tên lớp -->
                    <div class="col-md-6 mb-3">
                        <label for="Name" class="form-label">Tên lớp <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Name" name="Name" 
                               placeholder="VD: Lớp Công nghệ Thông tin K21A" required>
                        <div class="form-text">Tên đầy đủ của lớp hành chính</div>
                    </div>

                    <!-- Mã lớp -->
                    <div class="col-md-6 mb-3">
                        <label for="Code" class="form-label">Mã lớp</label>
                        <input type="text" class="form-control" id="Code" name="Code" 
                               placeholder="VD: CNTT21A (để trống để tự động tạo)">
                        <div class="form-text">Bỏ trống để hệ thống tự động tạo mã</div>
                    </div>
                </div>

                <div class="row">
                    <!-- Năm học -->
                    <div class="col-md-4 mb-3">
                        <label for="AcademicYear" class="form-label">Năm học <span class="text-danger">*</span></label>
                        <select class="form-select" id="AcademicYear" name="AcademicYear" required>
                            <option value="">-- Chọn năm học --</option>
                            @for (int i = currentYear - 5; i <= currentYear + 2; i++)
                            {
                                var academicYear = $"{i}-{i + 1}";
                                <option value="@academicYear" selected="@(i == currentYear - 4)">@academicYear</option>
                            }
                        </select>
                    </div>

                    <!-- Khóa -->
                    <div class="col-md-4 mb-3">
                        <label for="Intake" class="form-label">Khóa <span class="text-danger">*</span></label>
                        <select class="form-select" id="Intake" name="Intake" required>
                            <option value="">-- Chọn khóa --</option>
                            @for (int i = currentYear - 5; i <= currentYear + 2; i++)
                            {
                                var intakeCode = $"K{i.ToString().Substring(2)}";
                                <option value="@intakeCode" selected="@(i == currentYear - 4)">@intakeCode</option>
                            }
                        </select>
                    </div>

                    <!-- Sĩ số tối đa -->
                    <div class="col-md-4 mb-3">
                        <label for="MaxStudents" class="form-label">Sĩ số tối đa</label>
                        <input type="number" class="form-control" id="MaxStudents" name="MaxStudents" 
                               value="40" min="1" max="100">
                        <div class="form-text">Mặc định: 40 sinh viên</div>
                    </div>
                </div>

                <div class="row">
                    <!-- Bộ môn -->
                    <div class="col-md-6 mb-3">
                        <label for="DepartmentId" class="form-label">Bộ môn</label>
                        <select class="form-select" id="DepartmentId" name="DepartmentId">
                            <option value="">-- Không chọn bộ môn --</option>
                            @foreach (var dept in ViewBag.Departments as SelectList)
                            {
                                <option value="@dept.Value">@dept.Text</option>
                            }
                        </select>
                        <div class="form-text">Có thể để trống</div>
                    </div>

                    <!-- Giảng viên chủ nhiệm -->
                    <div class="col-md-6 mb-3">
                        <label for="AdvisorId" class="form-label">Giảng viên chủ nhiệm (GVCN)</label>
                        <select class="form-select" id="AdvisorId" name="AdvisorId">
                            <option value="">-- Chọn GVCN --</option>
                            @foreach (var teacher in ViewBag.Teachers as SelectList)
                            {
                                <option value="@teacher.Value">@teacher.Text</option>
                            }
                        </select>
                        <div class="form-text">Có thể chọn sau</div>
                    </div>
                </div>

                <!-- Trạng thái -->
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" checked>
                            <label class="form-check-label" for="IsActive">
                                Kích hoạt lớp ngay
                            </label>
                        </div>
                        <div class="form-text">Lớp kích hoạt sẽ hiển thị cho sinh viên và giảng viên</div>
                    </div>
                </div>

                <hr>

                <!-- Buttons -->
                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Tạo lớp hành chính
                        </button>
                        <a href="@Url.Action("AdministrativeClassManagement", "FacultyAdmin")" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Hủy bỏ
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Hướng dẫn -->
    <div class="card mt-4">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0"><i class="fas fa-info-circle"></i> Lưu ý</h6>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Lớp hành chính</strong> là lớp mà sinh viên thuộc về khi nhập học (khác với lớp học phần)</li>
                <li>Mã lớp sẽ được tạo tự động theo format: <code>MãKhoa + 2 số cuối năm + Chữ cái</code> (VD: CNTT21A)</li>
                <li>Một lớp hành chính có thể có 1 giảng viên chủ nhiệm</li>
                <li>Sinh viên chỉ thuộc về 1 lớp hành chính cố định trong suốt khóa học</li>
                <li>Sĩ số tối đa khuyến nghị: 35-45 sinh viên</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-generate Code based on AcademicYear and Intake
        document.getElementById('AcademicYear').addEventListener('change', updateCode);
        document.getElementById('Intake').addEventListener('change', updateCode);
        
        function updateCode() {
            var academicYear = document.getElementById('AcademicYear').value;
            var intake = document.getElementById('Intake').value;
            
            if (academicYear && intake) {
                var year = academicYear.split('-')[0].substring(2);
                var suggestion = 'CNTT' + year + 'A';
                document.getElementById('Code').placeholder = 'VD: ' + suggestion + ' (tự động)';
            }
        }
    </script>
}
