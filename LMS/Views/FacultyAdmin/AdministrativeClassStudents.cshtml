@model IEnumerable<LMS.Models.User>

@{
    ViewData["Title"] = "Danh sách sinh viên";
    Layout = "~/Views/Shared/_FacultyLayout.cshtml";
    var administrativeClass = ViewBag.AdministrativeClass as LMS.Models.AdministrativeClass;
    var facultyName = ViewBag.FacultyName as string;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-user-graduate"></i> Danh sách sinh viên lớp @administrativeClass.Code</h2>
            <p class="text-muted">
                @administrativeClass.Name - @facultyName<br />
                Năm học: @administrativeClass.AcademicYear | Khóa: @administrativeClass.Intake
                @if (administrativeClass.Advisor != null)
                {
                    <text><br />GVCN: @administrativeClass.Advisor.FullName</text>
                }
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("AdministrativeClassManagement", "FacultyAdmin")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-list"></i> Danh sách sinh viên (@Model.Count() / @administrativeClass.MaxStudents)
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>STT</th>
                                <th>MSSV</th>
                                <th>Họ và tên</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td><strong>@student.MssvMgv</strong></td>
                                    <td>@student.FullName</td>
                                    <td>@student.Email</td>
                                    <td>@(student.Phone ?? "Chưa cập nhật")</td>
                                    <td>
                                        @if (student.Status == "Active")
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@student.Status</span>
                                        }
                                    </td>
                                    <td>@student.CreatedAt?.ToString("dd/MM/yyyy")</td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Lớp chưa có sinh viên nào.
                </div>
            }
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card mt-3">
            <div class="card-body">
                <h6>Thống kê:</h6>
                <ul>
                    <li>Tổng sinh viên: <strong>@Model.Count()</strong></li>
                    <li>Sinh viên hoạt động: <strong>@Model.Count(u => u.Status == "Active")</strong></li>
                    <li>Còn trống: <strong>@(administrativeClass.MaxStudents - Model.Count())</strong> chỗ</li>
                    <li>Tỷ lệ lấp đầy: <strong>@Math.Round((double)Model.Count() / (administrativeClass.MaxStudents ?? 1) * 100, 1)%</strong></li>
                </ul>
            </div>
        </div>
    }
</div>
