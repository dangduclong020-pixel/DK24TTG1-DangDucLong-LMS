@model IEnumerable<LMS.Models.User>

@{
    ViewData["Title"] = "Quản lý sinh viên";
    Layout = "~/Views/Shared/_FacultyLayout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-0 text-primary">
                        <i class="fas fa-user-graduate"></i> Quản lý sinh viên
                    </h1>
                    <p class="text-muted mb-0">Quản lý sinh viên trong khoa</p>
                </div>
                <div class="btn-group" role="group">
                    <button class="btn btn-info" onclick="exportStudentsToExcel()">
                        <i class="fas fa-download"></i> Xuất Excel
                    </button>
                    <button class="btn btn-warning" onclick="autoAssignDepartments()">
                        <i class="fas fa-magic"></i> Tự động phân chuyên ngành
                    </button>
                    <button class="btn btn-success" onclick="importStudents()">
                        <i class="fas fa-file-excel"></i> Import từ Excel
                    </button>
                    <a href="@Url.Action("Index", "FacultyAdmin")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    <!-- Bộ lọc -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Bộ lọc tìm kiếm</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label for="studentClassFilter">Lớp hành chính:</label>
                    <select class="form-control" id="studentClassFilter">
                        <option value="">Tất cả</option>
                        @if (ViewBag.StudentClasses != null)
                        {
                            @foreach (var studentClass in ViewBag.StudentClasses)
                            {
                                <option value="@studentClass">@studentClass</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="departmentFilter">Chuyên ngành:</label>
                    <select class="form-control" id="departmentFilter">
                        <option value="">Tất cả</option>
                        @if (ViewBag.Departments != null)
                        {
                            @foreach (var dept in ViewBag.Departments)
                            {
                                <option value="@dept.DepartmentId">@dept.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="statusFilter">Trạng thái:</label>
                    <select class="form-control" id="statusFilter">
                        <option value="">Tất cả</option>
                        <option value="Active">Đang học</option>
                        <option value="Inactive">Tạm nghỉ</option>
                        <option value="Graduated">Đã tốt nghiệp</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchInput">Tìm kiếm:</label>
                    <input type="text" class="form-control" id="searchInput" placeholder="MSSV, tên sinh viên...">
                </div>
                <div class="col-md-2">
                    <label>&nbsp;</label>
                    <button class="btn btn-info btn-block" onclick="filterTable()">
                        <i class="fas fa-search"></i> Lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Danh sách sinh viên (@Model.Count() sinh viên)
                @{
                    var studentsWithoutDept = Model.Count(s => s.Department == null);
                    var studentsWithDept = Model.Count(s => s.Department != null);
                }
                @if (studentsWithoutDept > 0)
                {
                    <span class="badge badge-warning ml-2">
                        <i class="fas fa-exclamation-triangle"></i> @studentsWithoutDept chưa phân chuyên ngành
                    </span>
                }
                @if (studentsWithDept > 0)
                {
                    <span class="badge badge-success ml-2">
                        <i class="fas fa-check-circle"></i> @studentsWithDept đã phân chuyên ngành
                    </span>
                }
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="studentTable">
                    <thead class="thead-light">
                        <tr>
                            <th>MSSV</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Chuyên ngành/Bộ môn</th>
                            <th>Lớp hành chính</th>
                            <th>Trạng thái</th>
                            <th>Ngày nhập học</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="text-primary">@student.MssvMgv</strong>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle mr-2">
                                            @if (!string.IsNullOrEmpty(student.FullName))
                                            {
                                                @student.FullName.Split(' ').LastOrDefault()?.FirstOrDefault()
                                            }
                                        </div>
                                        <span>@student.FullName</span>
                                    </div>
                                </td>
                                <td>@student.Email</td>
                                <td>
                                    @if (student.Department != null)
                                    {
                                        <div class="department-info">
                                            <span class="badge badge-success">
                                                <i class="fas fa-graduation-cap"></i> @student.Department.Name
                                            </span>
                                            <br><small class="text-muted">@(student.Department.Description ?? "")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-department">
                                            <span class="badge badge-warning">
                                                <i class="fas fa-exclamation-triangle"></i> Chưa phân chuyên ngành
                                            </span>
                                            <br><small class="text-muted">Thuộc @(student.Faculty?.Name ?? "Chưa xác định")</small>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(student.StudentClass))
                                    {
                                        <span class="badge" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; font-size: 0.9em; font-weight: 600; padding: 6px 12px;">
                                            <i class="fas fa-users"></i> @student.StudentClass
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light" style="font-size: 0.85em; color: #6c757d; border: 1px dashed #dee2e6;">
                                            <i class="fas fa-question"></i> Chưa xác định
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var status = student.Status?.ToLower();
                                    }
                                    @switch (status)
                                    {
                                        case "active":
                                            <span class="badge badge-success">Đang học</span>
                                            break;
                                        case "inactive":
                                            <span class="badge badge-warning">Tạm nghỉ</span>
                                            break;
                                        case "graduated":
                                            <span class="badge badge-primary">Đã tốt nghiệp</span>
                                            break;
                                        default:
                                            <span class="badge badge-secondary">@(student.Status ?? "N/A")</span>
                                            break;
                                    }
                                </td>
                                <td>@student.CreatedAt?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-info" 
                                                onclick="updateStudentClass(@student.UserId, '@student.FullName', '@(student.StudentClass ?? "")')">
                                            <i class="fas fa-edit"></i> Cập nhật lớp
                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-warning" 
                                                onclick="assignDepartment(@student.UserId, '@student.FullName')"
                                                title="Phân chuyên ngành cho sinh viên">
                                            <i class="fas fa-graduation-cap"></i> Phân chuyên ngành
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="viewProgress(@student.UserId)">
                                            <i class="fas fa-chart-line"></i> Tiến độ
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal phân bộ môn -->
<div class="modal fade" id="departmentModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Phân chuyên ngành cho sinh viên</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="departmentForm" method="post" action="@Url.Action("AssignDepartment", "FacultyAdmin")">
                    <input type="hidden" id="studentIdDept" name="studentId" />
                    <div class="form-group">
                        <label>Sinh viên:</label>
                        <p id="studentNameDept" class="font-weight-bold text-primary"></p>
                    </div>
                    <div class="form-group">
                        <label for="departmentId">Chọn chuyên ngành:</label>
                        <select class="form-control" id="departmentId" name="departmentId" required>
                            <option value="">-- Chọn chuyên ngành --</option>
                            @if (ViewBag.Departments != null)
                            {
                                @foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId" title="@(dept.Description ?? "")">
                                        @dept.Name
                                        @if (!string.IsNullOrEmpty(dept.Description))
                                        {
                                            <text> - @dept.Description</text>
                                        }
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning" onclick="submitDepartment()">Xác nhận phân chuyên ngành</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal cập nhật lớp hành chính -->
<div class="modal fade" id="updateClassModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-edit"></i> Cập nhật lớp hành chính
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="updateClassForm" method="post" action="@Url.Action("UpdateStudentClass", "FacultyAdmin")">
                    <input type="hidden" id="updateClassStudentId" name="studentId" />
                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Sinh viên:</label>
                        <p id="updateClassStudentName" class="font-weight-bold text-primary mb-0"></p>
                    </div>
                    <div class="form-group">
                        <label for="studentClass"><i class="fas fa-school"></i> Lớp hành chính: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="studentClass" name="studentClass" 
                               placeholder="VD: CNTT K22A, NN K21B..." required maxlength="50">
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle"></i> Nhập tên lớp hành chính (lớp cố định suốt quá trình học)
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times"></i> Hủy
                </button>
                <button type="button" class="btn btn-info" onclick="submitUpdateClass()">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(45deg, #007bff, #28a745);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 12px;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    .btn-group .btn {
        margin-right: 5px;
    }

    .badge {
        font-size: 0.75em;
    }

    .department-info {
        min-height: 40px;
    }

    .no-department {
        min-height: 40px;
    }

    .badge-success {
        background-color: #28a745;
        animation: pulse-success 2s infinite;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #212529;
        animation: pulse-warning 2s infinite;
    }

    @@keyframes pulse-success {
        0% { opacity: 1; }
        50% { opacity: 0.7; }
        100% { opacity: 1; }
    }

    @@keyframes pulse-warning {
        0% { opacity: 1; }
        50% { opacity: 0.8; }
        100% { opacity: 1; }
    }
</style>

<script>
    function filterTable() {
        var classFilter = document.getElementById('studentClassFilter').value.toLowerCase();
        var departmentFilter = document.getElementById('departmentFilter').value.toLowerCase();
        var statusFilter = document.getElementById('statusFilter').value.toLowerCase();
        var searchInput = document.getElementById('searchInput').value.toLowerCase();
        var table = document.getElementById('studentTable');
        var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var cells = row.getElementsByTagName('td');
            
            var mssv = cells[0].textContent.toLowerCase();
            var fullName = cells[1].textContent.toLowerCase();
            var department = cells[3].textContent.toLowerCase();
            var className = cells[4].textContent.toLowerCase();
            var status = cells[5].textContent.toLowerCase();

            var matchClass = classFilter === '' || className.includes(classFilter);
            var matchDepartment = departmentFilter === '' || department.includes(departmentFilter);
            var matchStatus = statusFilter === '' || status.includes(statusFilter);
            var matchSearch = searchInput === '' || 
                            mssv.includes(searchInput) || 
                            fullName.includes(searchInput);

            if (matchClass && matchDepartment && matchStatus && matchSearch) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        }
    }

    function assignDepartment(studentId, studentName) {
        document.getElementById('studentIdDept').value = studentId;
        document.getElementById('studentNameDept').textContent = studentName;
        $('#departmentModal').modal('show');
    }

    function submitDepartment() {
        document.getElementById('departmentForm').submit();
    }

    function updateStudentClass(studentId, studentName, currentClass) {
        document.getElementById('updateClassStudentId').value = studentId;
        document.getElementById('updateClassStudentName').textContent = studentName;
        document.getElementById('studentClass').value = currentClass;
        $('#updateClassModal').modal('show');
    }

    function submitUpdateClass() {
        var form = document.getElementById('updateClassForm');
        var studentClass = document.getElementById('studentClass').value.trim();
        
        if (studentClass === '') {
            alert('Vui lòng nhập tên lớp hành chính!');
            document.getElementById('studentClass').focus();
            return false;
        }
        
        form.submit();
    }

    function viewProgress(studentId) {
        alert('Chức năng xem tiến độ học tập đang được phát triển. Student ID: ' + studentId);
    }

    function autoAssignDepartments() {
        if (confirm('Bạn có chắc chắn muốn tự động phân chuyên ngành cho tất cả sinh viên chưa được phân? Hành động này không thể hoàn tác.')) {
            // Tạo form để submit
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("AutoAssignDepartments", "FacultyAdmin")';
            
            // Thêm token chống CSRF nếu cần
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token.value;
                form.appendChild(tokenInput);
            }
            
            document.body.appendChild(form);
            form.submit();
        }
    }

    function exportStudentsToExcel() {
        // Lấy các giá trị filter hiện tại
        var administrativeClass = document.getElementById('studentClassFilter').value;
        var departmentId = document.getElementById('departmentFilter').value;
        
        // Tạo URL với parameters
        var url = '@Url.Action("ExportStudentsToExcel", "FacultyAdmin")';
        var params = [];
        
        if (administrativeClass && administrativeClass !== '') {
            params.push('administrativeClass=' + encodeURIComponent(administrativeClass));
        }
        
        if (departmentId && departmentId !== '') {
            params.push('departmentId=' + departmentId);
        }
        
        if (params.length > 0) {
            url += '?' + params.join('&');
        }
        
        // Tải file
        window.location.href = url;
    }

    function importStudents() {
        alert('Chức năng import sinh viên từ Excel đang được phát triển');
    }

    // Auto filter on input change
    document.getElementById('searchInput').addEventListener('keyup', filterTable);
    document.getElementById('classFilter').addEventListener('change', filterTable);
    document.getElementById('statusFilter').addEventListener('change', filterTable);
</script>