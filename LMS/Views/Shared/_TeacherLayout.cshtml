<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Giảng viên - LMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #1e7e34; /* Màu xanh lá - Đặc trưng cho Giảng viên */
            --primary-light: #d4edda;
            --bg-color: #f8f9fa;
            --sidebar-width: 280px;
            --text-color: #212529;
            --text-muted: #6c757d;
            --card-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            --border-radius: 0.375rem;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background-color: var(--bg-color); display: flex; min-height: 100vh; }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width); background: #fff; border-right: 1px solid #dee2e6;
            display: flex; flex-direction: column; position: fixed; height: 100%; top: 0; left: 0;
            box-shadow: var(--card-shadow);
        }
        .teacher-logo {
            height: 80px; display: flex; align-items: center; padding: 0 20px;
            border-bottom: 1px solid #dee2e6; gap: 12px; background: var(--primary-color);
        }
        .teacher-logo i { font-size: 28px; color: white; }
        .teacher-info h3 { font-size: 16px; font-weight: 700; color: white; }
        .teacher-info p { font-size: 12px; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 0.5px; }

        .menu { list-style: none; padding: 20px 15px; flex: 1; overflow-y: auto; }
        .menu-title { font-size: 11px; text-transform: uppercase; color: #6c757d; margin: 20px 15px 8px; font-weight: 600; }
        .menu-item {
            padding: 12px 15px; margin-bottom: 5px; display: flex; align-items: center;
            color: #495057; text-decoration: none; border-radius: var(--border-radius); 
            transition: all 0.2s; font-size: 14px; gap: 10px;
        }
        .menu-item:hover { background-color: var(--primary-light); color: var(--primary-color); text-decoration: none; }
        .menu-item.active { background-color: var(--primary-color); color: white; font-weight: 500; }
        .menu-item i { width: 20px; font-size: 16px; text-align: center; }

        /* Main Content */
        .main-content { margin-left: var(--sidebar-width); flex: 1; padding: 30px; }

        /* Header */
        .page-header { 
            display: flex; justify-content: space-between; align-items: center; 
            margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid #dee2e6;
        }
        .page-header h1 { font-size: 28px; font-weight: 600; color: var(--text-color); margin: 0; }
        .page-header .breadcrumb { margin: 0; background: none; padding: 0; }

        /* Stats Cards */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card {
            background: white; padding: 25px; border-radius: var(--border-radius);
            box-shadow: var(--card-shadow); border-left: 4px solid var(--primary-color);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15); }
        .stat-card h6 { font-size: 14px; color: var(--text-muted); font-weight: 500; margin-bottom: 10px; }
        .stat-value { font-size: 32px; font-weight: 700; color: var(--primary-color); }
        .stat-desc { font-size: 13px; margin-top: 8px; color: var(--text-muted); }

        /* Cards */
        .card {
            border: none; border-radius: var(--border-radius); box-shadow: var(--card-shadow);
            margin-bottom: 20px;
        }
        .card-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, #155724 100%);
            color: white; border-radius: var(--border-radius) var(--border-radius) 0 0 !important;
            padding: 15px 20px; border: none;
        }
        .card-title { margin: 0; font-size: 16px; font-weight: 600; }

        /* Tables */
        .table { margin: 0; }
        .table th { 
            background-color: #f8f9fa; border-bottom: 2px solid #dee2e6; 
            font-weight: 600; color: var(--text-color); font-size: 13px;
            padding: 12px; text-transform: uppercase; letter-spacing: 0.5px;
        }
        .table td { padding: 12px; vertical-align: middle; }
        .table-hover tbody tr:hover { background-color: var(--primary-light); }

        /* Buttons */
        .btn-primary { 
            background: var(--primary-color); border-color: var(--primary-color);
            font-weight: 500; padding: 8px 16px;
        }
        .btn-primary:hover { background: #155724; border-color: #155724; }

        /* Alerts */
        .alert { border-radius: var(--border-radius); border: none; }
        .alert-success { background-color: var(--primary-light); color: var(--primary-color); }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="teacher-logo">
            <i class="fas fa-chalkboard-teacher"></i>
            <div class="teacher-info">
                <h3>Giảng viên</h3>
                <p>TEACHER PORTAL</p>
            </div>
        </div>

        <ul class="menu">
            <li class="menu-title">TỔNG QUAN</li>
            <a href="@Url.Action("Index", "Teacher")" class="menu-item">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>

            <li class="menu-title">QUẢN LÝ LỚP HỌC</li>
            <a href="@Url.Action("MyClasses", "Teacher")" class="menu-item">
                <i class="fas fa-users"></i> Lớp học của tôi
            </a>
            <a href="@Url.Action("MySchedule", "Teacher")" class="menu-item">
                <i class="fas fa-calendar-alt"></i> Thời khóa biểu
            </a>
            <a href="@Url.Action("StudentProgress", "Teacher")" class="menu-item">
                <i class="fas fa-chart-line"></i> Tiến độ sinh viên
            </a>

            <li class="menu-title">BÀI TẬP & KIỂM TRA</li>
            <a href="@Url.Action("Assignments", "Teacher")" class="menu-item">
                <i class="fas fa-tasks"></i> Quản lý bài tập
            </a>
            <a href="@Url.Action("CreateAssignment", "Teacher")" class="menu-item">
                <i class="fas fa-plus"></i> Tạo bài tập mới
            </a>
            <a href="@Url.Action("Exams", "Teacher")" class="menu-item">
                <i class="fas fa-file-alt"></i> Quản lý đề thi
            </a>
            <a href="@Url.Action("QuestionBank", "Teacher")" class="menu-item">
                <i class="fas fa-question-circle"></i> Ngân hàng câu hỏi
            </a>

            <li class="menu-title">THÔNG BÁO</li>
            <a href="@Url.Action("SendNotification", "Teacher")" class="menu-item">
                <i class="fas fa-bullhorn"></i> Gửi thông báo
            </a>

            <li class="menu-title">HỆ THỐNG</li>
            <a href="@Url.Action("Logout", "Teacher")" class="menu-item">
                <i class="fas fa-sign-out-alt"></i> Đăng xuất
            </a>
        </ul>
    </aside>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    
    <script>
        // Active menu item
        $(document).ready(function() {
            var currentPath = window.location.pathname;
            $('.menu-item').each(function() {
                if ($(this).attr('href') === currentPath) {
                    $(this).addClass('active');
                }
            });

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut();
            }, 5000);
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>