@{
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
    var userName = ViewBag.UserName ?? "";
    var userRole = ViewBag.UserRole ?? "";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <div class="d-flex align-items-center">
            <button class="btn btn-link text-dark me-3" id="toggleSidebar">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">E-Learning - Trường Đại học Trà Vinh</a>
        </div>
        
        <div class="d-flex align-items-center ml-auto">
            <!-- Search Function -->
            <div class="header-search">
                <div class="search-input-container" id="searchContainer">
                    <input type="text" placeholder="Tìm kiếm..." id="searchInput">
                </div>
                <button class="search-icon-btn" id="searchBtn">
                    <i class="fas fa-search"></i>
                </button>
            </div>
            
            <!-- User Menu / Login Status -->
            @if (isLoggedIn)
            {
                <div class="user-menu">
                    <div class="user-info">
                        <div class="user-avatar">
                            @userName.Substring(0, 1).ToUpper()
                        </div>
                        <span class="user-name">@userName</span>
                        <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </div>
                    <div class="user-dropdown">
                        <div class="dropdown-header">
                            <i class="fas fa-user-circle"></i>
                            <span>@userRole</span>
                        </div>
                        <a href="@Url.Action("Profile", "Users")" class="dropdown-item">
                            <i class="fas fa-user"></i>
                            <span>Hồ sơ cá nhân</span>
                        </a>
                        <a href="@Url.Action("Settings", "Users")" class="dropdown-item">
                            <i class="fas fa-cog"></i>
                            <span>Cài đặt</span>
                        </a>
                        <a href="@Url.Action("Messages", "Users")" class="dropdown-item">
                            <i class="fas fa-envelope"></i>
                            <span>Tin nhắn</span>
                        </a>
                        <a href="@Url.Action("Logout", "Home")" class="dropdown-item">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Đăng xuất</span>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="login-status">
                    Bạn chưa đăng nhập.
                    <a href="@Url.Action("Login", "Home")" class="login-link">Đăng nhập</a>
                </div>
            }
        </div>
    </div>
</nav>
