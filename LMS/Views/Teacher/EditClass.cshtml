                }
            }
            
            // Di chuyển lên
            if (e.target.closest('.move-up-btn')) {
                const btn = e.target.closest('.move-up-btn');
                if (!btn.disabled) {
                    const chapterCard = btn.closest('.existing-chapter');
                    const prevChapter = chapterCard.previousElementSibling;
                    if (prevChapter && prevChapter.classList.contains('existing-chapter')) {
                        // Swap nội dung giữa 2 chapters (bao gồm cả video và assignments)
