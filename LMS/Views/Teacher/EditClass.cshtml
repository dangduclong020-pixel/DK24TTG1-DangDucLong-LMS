@model LMS.Models.Class
@{
    Layout = "~/Views/Shared/_LayoutWithSidebar.cshtml";
    ViewBag.Title = "Chỉnh sửa thông tin lớp học";
}

<style>
    .lesson-content-display {
        max-height: 300px;
        overflow-y: auto;
    }
    
    .lesson-content-display h1, .lesson-content-display h2, .lesson-content-display h3 {
        color: #333;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }
    
    .lesson-content-display ul, .lesson-content-display ol {
        padding-left: 2rem;
        margin-bottom: 1rem;
    }
    
    .lesson-content-display p {
        margin-bottom: 0.5rem;
        line-height: 1.6;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> 
                <strong>Gợi ý:</strong> Để xem đầy đủ nội dung lớp học (Tài liệu, Hoạt động, Điểm danh...), 
                <a href="@Url.Action("ClassDetails", "Teacher", new { id = Model.ClassId })" class="alert-link">
                    <i class="fas fa-eye"></i> nhấn vào đây
                </a>
            </div>
            
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-edit"></i> Chỉnh sửa thông tin lớp học
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="EditClass" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ClassId" value="@Model.ClassId" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã lớp học</label>
                            <input type="text" class="form-control" value="@Model.Code" readonly disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên lớp học</label>
                            <input type="text" class="form-control" value="@Model.Name" readonly disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Khóa học</label>
                            <input type="text" class="form-control" value="@Model.Course?.Code - @Model.Course?.Name" readonly disabled />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Khoa</label>
                                <input type="text" class="form-control" value="@Model.Course?.Faculty?.Name" readonly disabled />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Giảng viên</label>
                                <input type="text" class="form-control" value="@Model.Instructor?.FullName" readonly disabled />
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả lớp học <span class="text-danger">*</span></label>
                            <textarea name="Description" id="descriptionEditor" class="form-control" rows="8" 
                                      placeholder="Nhập mô tả chi tiết về lớp học, nội dung giảng dạy...">@Model.Description</textarea>
                            <small class="text-muted">Nhập giới thiệu về lớp học này, nội dung sẽ học, yêu cầu đối với sinh viên...</small>
                        </div>

                        <!-- Thêm hoạt động/tài nguyên cho lớp học -->
                        <div class="mt-3 mb-4 p-3 bg-light border rounded">
                            <button type="button" class="btn btn-link text-primary text-decoration-none p-0 fw-bold" 
                                    onclick="showMainActivityMenu()">
                                <i class="fas fa-plus-circle me-2"></i>
                                Thêm hoạt động hoặc tài nguyên
                            </button>
                            
                            <div id="mainActivityMenu" class="mt-3" style="display: none;">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <a href="@Url.Action("CreateAssignment", "Teacher", new { classId = Model.ClassId })" 
                                           class="btn btn-outline-primary w-100 text-start py-3">
                                            <i class="fas fa-tasks fa-2x d-block mb-2"></i>
                                            <strong>Bài tập</strong>
                                            <small class="d-block text-muted">Tạo bài tập mới</small>
                                        </a>
                                    </div>
                                    <div class="col-md-3">
                                        <a href="@Url.Action("CreateExam", "Teacher", new { classId = Model.ClassId })" 
                                           class="btn btn-outline-danger w-100 text-start py-3">
                                            <i class="fas fa-file-alt fa-2x d-block mb-2"></i>
                                            <strong>Kiểm tra</strong>
                                            <small class="d-block text-muted">Tạo bài kiểm tra</small>
                                        </a>
                                    </div>
                                    <div class="col-md-3">
                                        <a href="@Url.Action("CreateAttendance", "Teacher", new { classId = Model.ClassId })" 
                                           class="btn btn-outline-success w-100 text-start py-3">
                                            <i class="fas fa-clipboard-check fa-2x d-block mb-2"></i>
                                            <strong>Điểm danh</strong>
                                            <small class="d-block text-muted">Tạo phiên điểm danh</small>
                                        </a>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-outline-info w-100 text-start py-3" 
                                                onclick="alert('Chức năng tải tài liệu đang phát triển')">
                                            <i class="fas fa-file-upload fa-2x d-block mb-2"></i>
                                            <strong>Tài liệu</strong>
                                            <small class="d-block text-muted">Upload file</small>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Danh sách các chương hiện có -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="form-label fw-bold mb-0">Nội dung các chương</label>
                            </div>
                            
                            <div id="chaptersContainer">
                                @if (Model.Lessons != null && Model.Lessons.Any())
                                {
                                    var orderedLessons = Model.Lessons.Where(l => l.OrderNumber != 0).OrderBy(l => l.OrderNumber).ToList();
                                    for (int i = 0; i < orderedLessons.Count; i++)
                                    {
                                        var lesson = orderedLessons[i];
                                        <div class="mb-3 existing-chapter card" data-lesson-id="@lesson.LessonId" data-index="@i">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <h6 class="mb-0 text-primary">
                                                        <i class="fas fa-file-alt"></i> 
                                                        @if (!string.IsNullOrEmpty(lesson.Title))
                                                        {
                                                            @lesson.Title
                                                        }
                                                        else
                                                        {
                                                            <text>Nội dung @(i + 1)</text>
                                                        }
                                                    </h6>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary move-up-btn" 
                                                                title="Di chuyển lên" @(i == 0 ? "disabled" : "")>
                                                            <i class="fas fa-arrow-up"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary move-down-btn" 
                                                                title="Di chuyển xuống" @(i == orderedLessons.Count - 1 ? "disabled" : "")>
                                                            <i class="fas fa-arrow-down"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-danger btn-sm delete-existing-chapter-btn" 
                                                                data-lesson-id="@lesson.LessonId" 
                                                                title="Xóa nội dung này">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                
                                                <input type="hidden" name="ExistingLessons[@i].LessonId" value="@lesson.LessonId" class="lesson-id-field" />
                                                <input type="hidden" name="ExistingLessons[@i].OrderNumber" value="@lesson.OrderNumber" />
                                                <input type="hidden" name="ExistingLessons[@i].VideoUrl" value="@lesson.VideoUrl" class="video-url-field" />
                                                
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Tiêu đề chương</label>
                                                    <input type="text" name="ExistingLessons[@i].Title" class="form-control" 
                                                           value="@lesson.Title" placeholder="VD: Chương 1 - Giới thiệu về PHP" required />
                                                    <small class="text-muted">Tên hiển thị của chương này</small>
                                                </div>
                                                
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Nội dung chi tiết</label>
                                                    <textarea name="ExistingLessons[@i].Content" 
                                                              class="form-control existing-lesson-editor existing-editor-@i" 
                                                              rows="10">@lesson.Content</textarea>
                                                    <small class="text-muted mt-2 d-block">Bạn có thể chỉnh sửa nội dung trực tiếp tại đây</small>
                                                </div>
                                                
                                                @* Hiển thị video nếu có *@
                                                @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                                                {
                                                    <div class="mt-3 mb-3">
                                                        <h6 class="text-danger"><i class="fas fa-video"></i> Video Bài Giảng</h6>
                                                        <div class="p-2 mb-2 border rounded bg-light">
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <div>
                                                                    <i class="fab fa-youtube text-danger"></i>
                                                                    <a href="@lesson.VideoUrl" target="_blank">Xem video</a>
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-warning" 
                                                                        onclick="openEditVideoModal(@lesson.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lesson.VideoUrl ?? ""))')">
                                                                    <i class="fas fa-edit"></i> Sửa
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                
                                                @* Hiển thị bài tập của chương này *@
                                                @{
                                                    var lessonAssignments = Model.Assignments?.Where(a => a.LessonId == lesson.LessonId && a.DeletedAt == null).OrderBy(a => a.DueDate).ToList();
                                                }
                                                @if (lessonAssignments != null && lessonAssignments.Any())
                                                {
                                                    <div class="mt-3 mb-3">
                                                        <h6 class="text-primary"><i class="fas fa-tasks"></i> Bài tập trong chương này</h6>
                                                        @foreach (var assignment in lessonAssignments)
                                                        {
                                                            <div class="p-2 mb-2 border rounded bg-light">
                                                                <div class="d-flex align-items-center justify-content-between">
                                                                    <div>
                                                                        <i class="fas fa-file-alt text-danger"></i>
                                                                        <a href="@Url.Action("EditAssignment", "Teacher", new { id = assignment.AssignmentId })" target="_blank">@assignment.Title</a>
                                                                        @if (assignment.IsPublished != true)
                                                                        {
                                                                            <span class="badge bg-warning text-dark">Nháp</span>
                                                                        }
                                                                    </div>
                                                                    <small class="text-muted">@assignment.DueDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                
                                                @* Hiển thị kiểm tra của chương này *@
                                                @{
                                                    var lessonExams = Model.Exams?.Where(e => e.LessonId == lesson.LessonId && e.DeletedAt == null).OrderBy(e => e.StartTime).ToList();
                                                }
                                                @if (lessonExams != null && lessonExams.Any())
                                                {
                                                    <div class="mt-3 mb-3">
                                                        <h6 class="text-info"><i class="fas fa-clipboard-list"></i> Kiểm tra trong chương này</h6>
                                                        @foreach (var exam in lessonExams)
                                                        {
                                                            <div class="p-2 mb-2 border rounded bg-light">
                                                                <div class="d-flex align-items-center justify-content-between">
                                                                    <div>
                                                                        <i class="fas fa-file-alt text-success"></i>
                                                                        <a href="@Url.Action("EditExam", "Teacher", new { id = exam.ExamId })" target="_blank">@exam.Title</a>
                                                                    </div>
                                                                    <small class="text-muted">@exam.StartTime.ToString("dd/MM/yyyy HH:mm")</small>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                
                                                @* Hiển thị điểm danh của chương này *@
                                                @{
                                                    var lessonAttendances = Model.Attendances?.Where(a => a.LessonId == lesson.LessonId).OrderByDescending(a => a.StartTime).ToList();
                                                }
                                                @if (lessonAttendances != null && lessonAttendances.Any())
                                                {
                                                    <div class="mt-3 mb-3">
                                                        <h6 class="text-warning"><i class="fas fa-user-check"></i> Điểm danh trong chương này</h6>
                                                        @foreach (var attendance in lessonAttendances)
                                                        {
                                                            var totalStudents = Model.ClassStudents?.Count() ?? 0;
                                                            var presentCount = attendance.AttendanceRecords?.Count(ar => ar.Status == "Present") ?? 0;
                                                            var isClosed = attendance.Status == "Closed";
                                                            <div class="p-2 mb-2 border rounded bg-light">
                                                                <div class="d-flex align-items-center justify-content-between">
                                                                    <div>
                                                                        <i class="fas fa-clipboard-check @(isClosed ? "text-secondary" : "text-success")"></i>
                                                                        <a href="@Url.Action("TakeAttendance", "Teacher", new { id = attendance.AttendanceId })" target="_blank">@attendance.Title</a>
                                                                        <span class="badge @(isClosed ? "bg-secondary" : "bg-success")">@(isClosed ? "Đã đóng" : "Đang mở")</span>
                                                                    </div>
                                                                    <small class="text-muted">@presentCount/@totalStudents (@((totalStudents > 0 ? (presentCount * 100.0 / totalStudents) : 0).ToString("F0"))%)</small>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                
                                                <!-- Thêm hoạt động/tài nguyên -->
                                                <div class="mt-3 mb-3 p-3 bg-light border-start border-3 border-primary">
                                                    <button type="button" class="btn btn-link text-primary text-decoration-none p-0" 
                                                            onclick="showActivityMenu(@lesson.LessonId)">
                                                        <i class="fas fa-plus-circle me-2"></i>
                                                        <strong>Thêm hoạt động hoặc tài nguyên</strong>
                                                    </button>
                                                    
                                                    <!-- Menu hoạt động -->
                                                    <div id="activityMenu-@lesson.LessonId" class="mt-3" style="display: none;">
                                                        <div class="row g-2">
                                                            <div class="col-md-3">
                                                                <a href="@Url.Action("CreateAssignment", "Teacher", new { classId = Model.ClassId, lessonId = lesson.LessonId })" 
                                                                   class="btn btn-outline-primary w-100 text-start">
                                                                    <i class="fas fa-tasks me-2"></i>Bài tập
                                                                </a>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <a href="@Url.Action("CreateExam", "Teacher", new { classId = Model.ClassId, lessonId = lesson.LessonId })" 
                                                                   class="btn btn-outline-danger w-100 text-start">
                                                                    <i class="fas fa-file-alt me-2"></i>Kiểm tra
                                                                </a>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <a href="@Url.Action("CreateAttendance", "Teacher", new { classId = Model.ClassId, lessonId = lesson.LessonId })" 
                                                                   class="btn btn-outline-success w-100 text-start">
                                                                    <i class="fas fa-clipboard-check me-2"></i>Điểm danh
                                                                </a>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <button type="button" class="btn btn-outline-danger w-100 text-start" 
                                                                        onclick="openEditVideoModal(@lesson.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lesson.VideoUrl ?? ""))')">
                                                                    <i class="fas fa-video me-2"></i>Video
                                                                </button>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <button type="button" class="btn btn-outline-info w-100 text-start" 
                                                                        onclick="alert('Chức năng tải tài liệu đang phát triển')">
                                                                    <i class="fas fa-file-upload me-2"></i>Tài liệu
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                <!-- Các chương mới sẽ được thêm vào đây -->
                            </div>
                            
                            <div class="d-flex justify-content-center mt-3">
                                <button type="button" class="btn btn-success" id="addChapterBtn">
                                    <i class="fas fa-plus"></i> Thêm chương mới
                                </button>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> 
                            <strong>Lưu ý:</strong> Bạn có thể tự do chỉnh sửa mô tả và mục tiêu cho lớp học của mình. 
                            Nội dung này sẽ được hiển thị cho sinh viên khi họ truy cập vào lớp học.
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("ClassDetails", new { id = Model.ClassId })" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu tất cả
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm/sửa video -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="videoModalTitle">Thêm Video Bài Giảng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="videoLessonId" />
                <div class="mb-3">
                    <label for="videoUrl" class="form-label fw-bold">
                        <i class="fas fa-video text-danger"></i> Link Video
                    </label>
                    <input type="url" class="form-control" id="videoUrl" 
                           placeholder="https://www.youtube.com/watch?v=..." required />
                    <small class="text-muted">Hỗ trợ: YouTube, Vimeo, Dailymotion...</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Hủy
                </button>
                <button type="button" class="btn btn-primary" onclick="saveVideo()">
                    <i class="fas fa-save"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <!-- CKEditor 5 -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>
    <script>
        // Đảm bảo CKEditor đã load xong
        if (typeof ClassicEditor === 'undefined') {
            console.error('CKEditor chưa load xong!');
        }

        // Cấu hình CKEditor với indent/outdent
        const editorConfig = {
            toolbar: [
                'heading', '|',
                'bold', 'italic', '|',
                'bulletedList', 'numberedList', '|',
                'outdent', 'indent', '|',
                'link', '|',
                'undo', 'redo'
            ]
        };

        // Khởi tạo CKEditor cho Mô tả lớp học
        ClassicEditor
            .create(document.querySelector('#descriptionEditor'), editorConfig)
            .then(editor => {
                window.descriptionEditor = editor;
                console.log('Description editor initialized');
                
                // Bắt Tab key để thêm khoảng trắng hoặc indent
                const editorElement = editor.ui.view.editable.element;
                editorElement.addEventListener('keydown', function(e) {
                    if (e.key === 'Tab') {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const selection = editor.model.document.selection;
                        const hasSelection = !selection.isCollapsed;
                        
                        if (e.shiftKey) {
                            editor.execute('outdent');
                        } else {
                            if (hasSelection) {
                                editor.execute('indent');
                            } else {
                                const viewFragment = editor.data.processor.toView('&nbsp;&nbsp;&nbsp;&nbsp;');
                                const modelFragment = editor.data.toModel(viewFragment);
                                editor.model.insertContent(modelFragment);
                            }
                        }
                    }
                }, true);
            })
            .catch(error => {
                console.error('Error initializing description editor:', error);
            });

        // Khởi tạo CKEditor cho các chương hiện có
        document.querySelectorAll('.existing-lesson-editor').forEach((textarea, index) => {
            textarea.setAttribute('data-editor-index', index);
            ClassicEditor
                .create(textarea, editorConfig)
                .then(editor => {
                    window['existingEditor_' + index] = editor;
                    // Lưu reference vào textarea để dễ tìm sau này
                    textarea._ckEditor = editor;
                    textarea._editorIndex = index;
                    console.log('Existing lesson editor ' + index + ' initialized');
                    
                    // Bắt Tab key
                    const editorElement = editor.ui.view.editable.element;
                    editorElement.addEventListener('keydown', function(e) {
                        if (e.key === 'Tab') {
                            e.preventDefault();
                            e.stopPropagation();
                            
                            const selection = editor.model.document.selection;
                            const hasSelection = !selection.isCollapsed;
                            
                            if (e.shiftKey) {
                                editor.execute('outdent');
                            } else {
                                if (hasSelection) {
                                    editor.execute('indent');
                                } else {
                                    const viewFragment = editor.data.processor.toView('&nbsp;&nbsp;&nbsp;&nbsp;');
                                    const modelFragment = editor.data.toModel(viewFragment);
                                    editor.model.insertContent(modelFragment);
                                }
                            }
                        }
                    }, true);
                })
                .catch(error => {
                    console.error('Error initializing existing lesson editor ' + index + ':', error);
                });
        });

        // Xử lý submit form
        const formElement = document.querySelector('form');
        formElement.addEventListener('submit', function(e) {
            e.preventDefault();
            
            console.log('=== FORM SUBMIT STARTED ===');
            
            // 1. Sync mô tả
            const descriptionValue = window.descriptionEditor ? window.descriptionEditor.getData() : '';
            document.querySelector('[name="Description"]').value = descriptionValue;
            console.log('✓ Description synced');
            
            // 2. Đảm bảo tất cả các chương hiện có có index đúng trước khi sync
            const existingChapters = document.querySelectorAll('.existing-chapter:not([style*="display: none"])');
            console.log('Found ' + existingChapters.length + ' existing chapters');
            
            // Cập nhật lại index cho tất cả các chương theo thứ tự hiện tại
            existingChapters.forEach(function(chapter, correctIndex) {
                console.log('Processing existing chapter at position:', correctIndex);
                
