// Hàm đánh số lại tất cả các chapter mới
        function renumberChapters() {
            const existingChapterCount = document.querySelectorAll('.existing-chapter').length;
            const chapterItems = document.querySelectorAll('.chapter-item');
            
            chapterItems.forEach((item, index) => {
                const newChapterNumber = existingChapterCount + index + 1;
                
                // Cập nhật data-index
                item.dataset.index = index;
                
                // Cập nhật tiêu đề hiển thị
                const header = item.querySelector('h6');
                if (header) {
                    header.innerHTML = `<i class="fas fa-file-alt"></i> Nội dung mới ${newChapterNumber}`;
                }
                
                // Cập nhật các hidden inputs
                const orderInput = item.querySelector('input[name^="NewChapters"][name$=".OrderNumber"]');
                if (orderInput) {
                    orderInput.name = `NewChapters[${index}].OrderNumber`;
                    orderInput.value = newChapterNumber;
                }
                
                const titleInput = item.querySelector('input[name^="NewChapters"][name$=".Title"]');
                if (titleInput) {
                    titleInput.name = `NewChapters[${index}].Title`;
                    titleInput.value = `Chương ${newChapterNumber}`;
                }
                
                // Cập nhật textarea name và class
                const textarea = item.querySelector('textarea');
                if (textarea) {
                    const oldClass = textarea.className.match(/chapter-editor-\d+/);
                    if (oldClass) {
                        textarea.classList.remove(oldClass[0]);
                    }
                    textarea.classList.add(`chapter-editor-${index}`);
                    textarea.classList.add('chapter-content-input');
                    textarea.name = `NewChapters[${index}].Content`;
                }
                
                // Cập nhật editor reference trong window object
                const oldEditorKey = Object.keys(window).find(key => 
                    key.startsWith('chapterEditor_') && 
                    window[key] && 
                    window[key].sourceElement === textarea
                );
                
                if (oldEditorKey && oldEditorKey !== `chapterEditor_${index}`) {
                    window[`chapterEditor_${index}`] = window[oldEditorKey];
                    delete window[oldEditorKey];
                }
            });
            
            // Cập nhật counter
            newChapterCount = chapterItems.length;
        }

// Xóa chương mới (chưa lưu)
        document.getElementById('chaptersContainer').addEventListener('click', function(e) {
            if (e.target.closest('.remove-chapter-btn')) {
                const chapterItem = e.target.closest('.chapter-item');
                const chapterIndex = chapterItem.dataset.index;
                
                // Destroy CKEditor instance
                if (window['chapterEditor_' + chapterIndex]) {
                    window['chapterEditor_' + chapterIndex].destroy()
                        .then(() => {
                            delete window['chapterEditor_' + chapterIndex];
                            chapterItem.remove();
                            // Đánh số lại tất cả các chapter còn lại
                            renumberChapters();
                        })
                        .catch(error => console.error(error));
                } else {
                    chapterItem.remove();
                    // Đánh số lại tất cả các chapter còn lại
                    renumberChapters();
                }
            }
            
            // Xóa chương hiện có (đã lưu)
            if (e.target.closest('.delete-existing-chapter-btn')) {
                const btn = e.target.closest('.delete-existing-chapter-btn');
                const lessonId = btn.dataset.lessonId;
                const chapterCard = e.target.closest('.existing-chapter');
                const chapterIndex = chapterCard.dataset.index;
                
                if (confirm('Bạn có chắc chắn muốn xóa chương này không?')) {
                    // Destroy CKEditor instance nếu có
                    if (window['existingEditor_' + chapterIndex]) {
                        window['existingEditor_' + chapterIndex].destroy()
                            .then(() => {
                                delete window['existingEditor_' + chapterIndex];
                            })
                            .catch(error => console.error(error));
                    }
                    
                    // Set LessonId về -lessonId để đánh dấu xóa
                    const lessonIdField = chapterCard.querySelector('.lesson-id-field');
                    if (lessonIdField) {
                        lessonIdField.value = '-' + lessonId;
                    }
                    
                    // Ẩn card
