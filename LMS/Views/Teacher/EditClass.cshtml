        }

        // Update chapter order after move
        function updateChapterOrder() {
            // Chỉ cập nhật các chương hiện có (không bao gồm chương mới)
            const existingChapters = document.querySelectorAll('.existing-chapter:not([style*="display: none"])');
            
            // Lưu lại mapping giữa vị trí và LessonId
            const lessonIdByPosition = new Map();
            existingChapters.forEach((chapter, index) => {
                const lessonIdInput = chapter.querySelector('input[name*="LessonId"]');
                if (lessonIdInput) {
                    lessonIdByPosition.set(index, lessonIdInput.value);
                }
            });
            
            existingChapters.forEach((chapter, newIndex) => {
                const newOrder = newIndex + 1;
                
                // Cập nhật data-index
                chapter.dataset.index = newIndex;
                
                // Cập nhật TẤT CẢ các input name với index mới
                const lessonIdInput = chapter.querySelector('input[name*="LessonId"]');
                if (lessonIdInput) {
                    lessonIdInput.name = `ExistingLessons[${newIndex}].LessonId`;
                    // GIỮ NGUYÊN giá trị LessonId - không thay đổi
                }
                
                const orderInput = chapter.querySelector('input[name*="OrderNumber"]');
                if (orderInput) {
                    orderInput.name = `ExistingLessons[${newIndex}].OrderNumber`;
                    orderInput.value = newOrder;
                }
                
                const titleInput = chapter.querySelector('input[name*="Title"]');
                if (titleInput) {
                    titleInput.name = `ExistingLessons[${newIndex}].Title`;
                }
                
                const contentTextarea = chapter.querySelector('textarea[name*="Content"]');
                if (contentTextarea) {
                    contentTextarea.name = `ExistingLessons[${newIndex}].Content`;
                    
                    // Giữ nguyên data-editor-index và _editorIndex - không thay đổi
                    // Vì editor reference trong window không thay đổi vị trí
                    
                    // Cập nhật class của textarea
                    const oldClass = contentTextarea.className.match(/existing-editor-\d+/);
                    if (oldClass) {
                        contentTextarea.classList.remove(oldClass[0]);
                    }
                    contentTextarea.classList.add(`existing-editor-${newIndex}`);
                }
                
                // Update title header
                const titleHeader = chapter.querySelector('h6');
                if (titleHeader && titleInput) {
                    const icon = titleHeader.querySelector('i');
                    const currentTitle = titleInput.value;
                    titleHeader.innerHTML = (icon ? icon.outerHTML : '<i class="fas fa-file-alt"></i>') + ' ' + currentTitle;
                }
                
                // Update move buttons state
                const moveUpBtn = chapter.querySelector('.move-up-btn');
                const moveDownBtn = chapter.querySelector('.move-down-btn');
                
                if (moveUpBtn) {
                    moveUpBtn.disabled = (newIndex === 0);
                }
                if (moveDownBtn) {
                    moveDownBtn.disabled = (newIndex === existingChapters.length - 1);
                }
            });
            
            console.log('✓ Chapter order updated - total:', existingChapters.length);
        }

        // Open video modal
        let currentEditingLessonId = null;
        function openEditVideoModal(lessonId, currentVideoUrl) {
            currentEditingLessonId = lessonId;
            document.getElementById('videoLessonId').value = lessonId;
            document.getElementById('videoUrl').value = currentVideoUrl || '';
            document.getElementById('videoModalTitle').textContent = currentVideoUrl ? 'Chỉnh sửa Video Bài Giảng' : 'Thêm Video Bài Giảng';
            const modal = new bootstrap.Modal(document.getElementById('videoModal'));
            modal.show();
        }

        // Save video
        async function saveVideo() {
            const lessonId = document.getElementById('videoLessonId').value;
            const videoUrl = document.getElementById('videoUrl').value.trim();
            
            if (!videoUrl) {
                alert('Vui lòng nhập link video!');
                return;
            }

            try {
                const response = await fetch('@Url.Action("UpdateLessonVideo", "Teacher")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        lessonId: parseInt(lessonId),
                        videoUrl: videoUrl
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    // Cập nhật input hidden VideoUrl để giữ lại khi submit form
                    const lessonCards = document.querySelectorAll('.card.mb-3.existing-lesson-card');
                    lessonCards.forEach(card => {
                        const cardLessonId = card.querySelector('input.lesson-id-field');
                        if (cardLessonId && cardLessonId.value == lessonId) {
                            const videoUrlInput = card.querySelector('input.video-url-field');
                            if (videoUrlInput) {
                                videoUrlInput.value = videoUrl;
                                console.log('✓ Updated VideoUrl in hidden input');
                            }
                        }
                    });
                    
                    alert('Cập nhật video thành công!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + (result.message || 'Không thể cập nhật video'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi cập nhật video!');
            }
        }
    </script>
}
