        // Swap editor content between two chapters
        function swapEditorContent(chapter1, chapter2) {
            const textarea1 = chapter1.querySelector('textarea[name*="Content"]');
            const textarea2 = chapter2.querySelector('textarea[name*="Content"]');
            
            if (!textarea1 || !textarea2) {
                console.error('Could not find textareas to swap');
                return;
            }
            
            // Lấy editor từ data-editor-index
            const editorIndex1 = textarea1.getAttribute('data-editor-index') || textarea1._editorIndex;
            const editorIndex2 = textarea2.getAttribute('data-editor-index') || textarea2._editorIndex;
            
            const editor1 = window['existingEditor_' + editorIndex1] || textarea1._ckEditor;
            const editor2 = window['existingEditor_' + editorIndex2] || textarea2._ckEditor;
            
            if (!editor1 || !editor2) {
                console.error('Could not find editors to swap');
                return;
            }
            
            // Lấy content từ cả 2 editors
            const content1 = editor1.getData();
            const content2 = editor2.getData();
            
            // Swap content trong editor
            editor1.setData(content2);
            editor2.setData(content1);
            
            // Swap toàn bộ các input fields (LessonId, OrderNumber, VideoUrl, Title)
            const allInputs1 = chapter1.querySelectorAll('input[type="hidden"], input[type="text"]');
            const allInputs2 = chapter2.querySelectorAll('input[type="hidden"], input[type="text"]');
            
            allInputs1.forEach((input1, index) => {
                const input2 = allInputs2[index];
                if (input1 && input2) {
                    // Swap value
                    const temp = input1.value;
                    input1.value = input2.value;
                    input2.value = temp;
                }
            });
            
            // Swap phần hiển thị video - tìm div chứa "Video Bài Giảng"
            const videoSection1 = Array.from(chapter1.querySelectorAll('.mt-3.mb-3')).find(el => 
                el.textContent.includes('Video Bài Giảng')
            );
            const videoSection2 = Array.from(chapter2.querySelectorAll('.mt-3.mb-3')).find(el => 
                el.textContent.includes('Video Bài Giảng')
            );
            
            console.log('Video sections found:', {
                chapter1HasVideo: !!videoSection1,
                chapter2HasVideo: !!videoSection2
            });
            
            // Lưu HTML của 2 video sections (hoặc null nếu không có)
            const videoHtml1 = videoSection1 ? videoSection1.outerHTML : null;
            const videoHtml2 = videoSection2 ? videoSection2.outerHTML : null;
            
            // Xóa video sections cũ
            if (videoSection1) {
                videoSection1.remove();
                console.log('Removed video from chapter1');
            }
            if (videoSection2) {
                videoSection2.remove();
                console.log('Removed video from chapter2');
            }
            
            // Tìm vị trí để insert video (sau textarea container)
            const textarea1Container = chapter1.querySelector('textarea[name*="Content"]')?.closest('.mb-3');
            const textarea2Container = chapter2.querySelector('textarea[name*="Content"]')?.closest('.mb-3');
            
            // Insert video vào vị trí mới
            if (videoHtml2 && textarea1Container) {
                textarea1Container.insertAdjacentHTML('afterend', videoHtml2);
                console.log('✓ Inserted video into chapter1');
            }
            if (videoHtml1 && textarea2Container) {
                textarea2Container.insertAdjacentHTML('afterend', videoHtml1);
                console.log('✓ Inserted video into chapter2');
            }
            
            // Swap title trong header
            const title1Input = chapter1.querySelector('input[name*="Title"]');
            const title2Input = chapter2.querySelector('input[name*="Title"]');
            if (title1Input && title2Input) {
                const header1 = chapter1.querySelector('h6.text-primary');
                const header2 = chapter2.querySelector('h6.text-primary');
                if (header1 && header2) {
                    const icon = '<i class="fas fa-file-alt"></i>';
                    header1.innerHTML = icon + ' ' + title1Input.value;
                    header2.innerHTML = icon + ' ' + title2Input.value;
                }
            }
            
            // Swap assignments sections
            const assignmentsSection1 = Array.from(chapter1.querySelectorAll('.mt-3.mb-3')).find(el => 
                el.querySelector('h6.text-primary')?.textContent.includes('Bài tập')
            );
            const assignmentsSection2 = Array.from(chapter2.querySelectorAll('.mt-3.mb-3')).find(el => 
                el.querySelector('h6.text-primary')?.textContent.includes('Bài tập')
            );
            
            const assignmentsHtml1 = assignmentsSection1 ? assignmentsSection1.outerHTML : null;
            const assignmentsHtml2 = assignmentsSection2 ? assignmentsSection2.outerHTML : null;
            
            if (assignmentsSection1) assignmentsSection1.remove();
            if (assignmentsSection2) assignmentsSection2.remove();
            
            // Insert assignments vào vị trí mới (sau video hoặc sau textarea)
            const insertPoint1 = chapter1.querySelector('.mt-3.mb-3.p-3.bg-light.border-start') || 
                                chapter1.querySelector('.card-body');
            const insertPoint2 = chapter2.querySelector('.mt-3.mb-3.p-3.bg-light.border-start') || 
                                chapter2.querySelector('.card-body');
            
            if (assignmentsHtml2 && insertPoint1) {
                if (insertPoint1.classList?.contains('card-body')) {
                    insertPoint1.insertAdjacentHTML('beforeend', assignmentsHtml2);
                } else {
                    insertPoint1.insertAdjacentHTML('beforebegin', assignmentsHtml2);
                }
            }
            if (assignmentsHtml1 && insertPoint2) {
                if (insertPoint2.classList?.contains('card-body')) {
                    insertPoint2.insertAdjacentHTML('beforeend', assignmentsHtml1);
                } else {
                    insertPoint2.insertAdjacentHTML('beforebegin', assignmentsHtml1);
                }
            }
            
            console.log('✓ Swapped content, video, and assignments successfully');
        }
        
        // Khởi tạo lại CKEditor sau khi swap innerHTML
        function initializeEditorsAfterSwap() {
            const existingChapters = document.querySelectorAll('.existing-chapter:not([style*="display: none"])');
            existingChapters.forEach((chapter, index) => {
                const textarea = chapter.querySelector('textarea[name*="Content"]');
                if (textarea && !textarea._ckEditor) {
                    const editorIndex = index;
                    textarea.setAttribute('data-editor-index', editorIndex);
                    textarea._editorIndex = editorIndex;
                    
                    ClassicEditor
                        .create(textarea, {
                            toolbar: ['heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'blockQuote', 'insertTable', 'undo', 'redo']
                        })
                        .then(editor => {
                            window['existingEditor_' + editorIndex] = editor;
                            textarea._ckEditor = editor;
                            console.log('✓ Initialized editor after swap:', editorIndex);
                        })
                        .catch(error => {
                            console.error('Error initializing editor after swap:', error);
                        });
                }
            });
        }
        
        // Sync editor content to textarea before move
        function syncEditorsBeforeMove(chapters) {
            chapters.forEach(chapter => {
                const textarea = chapter.querySelector('textarea[name*="Content"]');
                if (textarea) {
                    const editorIndex = textarea.getAttribute('data-editor-index') || textarea._editorIndex;
                    const editor = window['existingEditor_' + editorIndex] || textarea._ckEditor;
                    if (editor) {
                        textarea.value = editor.getData();
                    }
                }
            });
        }
        
        // Sync textarea content back to editor after move
        function syncEditorsAfterMove(chapters) {
            // Sau khi di chuyển, cập nhật lại tất cả editor references theo vị trí mới
            const allChapters = document.querySelectorAll('.existing-chapter:not([style*="display: none"])');
            
            allChapters.forEach((chapter, newPosition) => {
                const textarea = chapter.querySelector('textarea[name*="Content"]');
                if (textarea) {
                    // Tìm editor hiện tại của textarea này
                    let currentEditor = null;
                    let oldEditorKey = null;
                    
                    for (let key in window) {
                        if (key.startsWith('existingEditor_') && window[key]) {
                            try {
                                if (window[key].sourceElement === textarea || window[key]._sourceElement === textarea) {
                                    currentEditor = window[key];
                                    oldEditorKey = key;
                                    break;
                                }
                            } catch(e) {}
                        }
                    }
                    
                    if (!currentEditor && textarea._ckEditor) {
                        currentEditor = textarea._ckEditor;
                    }
                    
                    if (currentEditor) {
                        // Cập nhật lại key của editor theo vị trí mới
                        const newEditorKey = 'existingEditor_' + newPosition;
                        if (oldEditorKey !== newEditorKey) {
                            window[newEditorKey] = currentEditor;
                            if (oldEditorKey && oldEditorKey !== newEditorKey) {
                                delete window[oldEditorKey];
                            }
                            console.log('✓ Updated editor reference:', oldEditorKey, '→', newEditorKey);
                        }
                        
                        // Cập nhật data attributes
                        textarea.setAttribute('data-editor-index', newPosition);
                        textarea._editorIndex = newPosition;
                        textarea._ckEditor = currentEditor;
                    }
                }
            });
        }

        // Alert save first
        function alertSaveFirst() {
