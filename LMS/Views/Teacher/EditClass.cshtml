                    const chapterCard = btn.closest('.existing-chapter');
                    const nextChapter = chapterCard.nextElementSibling;
                    if (nextChapter && nextChapter.classList.contains('existing-chapter')) {
                        // Swap nội dung giữa 2 chapters (bao gồm cả video và assignments)
                        swapEditorContent(chapterCard, nextChapter);
                        
                        // Cập nhật lại order và index
                        updateChapterOrder();
                        
                        console.log('✓ Moved chapter down');
                    }
                }
            }
        });

