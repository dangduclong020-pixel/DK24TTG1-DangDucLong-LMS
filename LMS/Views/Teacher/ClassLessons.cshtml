@model List<LMS.Models.Lesson>
@{
    ViewData["Title"] = "Quản lý nội dung giảng dạy";
    var classInfo = ViewBag.ClassInfo as LMS.Models.Class;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-book-open"></i> Quản lý nội dung giảng dạy
                    </h4>
                </div>
                <div class="card-body">
                    <h5><strong>Môn học:</strong> @classInfo?.Course?.Name</h5>
                    <p class="mb-0">
                        <strong>Lớp:</strong> @classInfo?.Name (@classInfo?.Code) | 
                        <strong>Số bài học:</strong> @Model.Count
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row mb-3">
        <div class="col-md-12">
            <a href="@Url.Action("CreateLesson", new { classId = classInfo?.ClassId })" class="btn btn-success">
                <i class="fas fa-plus"></i> Tạo bài học mới
            </a>
            <a href="@Url.Action("ClassDetails", new { id = classInfo?.ClassId })" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại lớp học
            </a>
        </div>
    </div>

    <!-- Lessons List -->
    <div class="row">
        <div class="col-md-12">
            @if (Model.Any())
            {
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tuần</th>
                                        <th>Thứ tự</th>
                                        <th>Tiêu đề</th>
                                        <th>Thời lượng (phút)</th>
                                        <th>Số file</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lesson in Model)
                                    {
                                        <tr>
                                            <td><span class="badge bg-primary">Tuần @lesson.Week</span></td>
                                            <td>@lesson.OrderNumber</td>
                                            <td>
                                                <strong>@lesson.Title</strong>
                                                @if (!string.IsNullOrEmpty(lesson.Content))
                                                {
                                                    <br />
                                                    <small class="text-muted">@(lesson.Content.Length > 100 ? lesson.Content.Substring(0, 100) + "..." : lesson.Content)</small>
                                                }
                                            </td>
                                            <td>@lesson.Duration phút</td>
                                            <td>
                                                <span class="badge bg-info">
                                                    <i class="fas fa-file"></i> @lesson.LessonFiles.Count file
                                                </span>
                                            </td>
                                            <td>
                                                @if (lesson.IsPublished == true)
                                                {
                                                    <span class="badge bg-success">Đã xuất bản</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Nháp</span>
                                                }
                                            </td>
                                            <td>@lesson.CreatedAt?.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <a href="@Url.Action("EditLesson", new { id = lesson.LessonId })" 
                                                   class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button onclick="deleteLesson(@lesson.LessonId)" 
                                                        class="btn btn-sm btn-danger" title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Chưa có bài học nào. Hãy tạo bài học đầu tiên!
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteLesson(lessonId) {
            if (confirm('Bạn có chắc muốn xóa bài học này?')) {
                $.ajax({
                    url: '@Url.Action("DeleteLesson")',
                    type: 'POST',
                    data: { id: lessonId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Lỗi: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra khi xóa bài học!');
                    }
                });
            }
        }
    </script>
}
