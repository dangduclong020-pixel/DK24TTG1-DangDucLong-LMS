@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewBag.Title = "Lớp học của tôi";
}

@model IEnumerable<LMS.Models.Class>

<div class="page-header">
    <div>
        <h1><i class="fas fa-users me-2"></i>Lớp học của tôi</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Teacher")">Dashboard</a></li>
                <li class="breadcrumb-item active">Lớp học</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tìm kiếm lớp học</label>
                <input type="text" class="form-control" name="search" value="@ViewBag.CurrentSearch" 
                       placeholder="Tên lớp, mã lớp...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Khoa</label>
                <select class="form-select" name="facultyId">
                    <option value="">Tất cả khoa</option>
                    @if (ViewBag.Faculties != null)
                    {
                        @foreach (var faculty in ViewBag.Faculties)
                        {
                            <option value="@faculty.FacultyId" selected="@(ViewBag.CurrentFaculty?.ToString() == faculty.FacultyId.ToString())">
                                @faculty.FacultyName
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <select class="form-select" name="status">
                    <option value="">Tất cả</option>
                    <option value="active" selected="@(ViewBag.CurrentStatus == "active")">Đang hoạt động</option>
                    <option value="completed" selected="@(ViewBag.CurrentStatus == "completed")">Đã kết thúc</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Classes Grid -->
@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var classItem in Model)
        {
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">@classItem.Name</h6>
                            <small class="text-muted">@classItem.Course?.Name</small>
                        </div>
                        <span class="badge @(classItem.IsActive == true ? "bg-success" : "bg-secondary")">
                            @(classItem.IsActive == true ? "Hoạt động" : "Kết thúc")
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <div class="border-end">
                                    <h4 class="text-primary mb-0">@(classItem.ClassStudents?.Count ?? 0)</h4>
                                    <small class="text-muted">Sinh viên</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border-end">
                                    <h4 class="text-warning mb-0">@(classItem.Assignments?.Count ?? 0)</h4>
                                    <small class="text-muted">Bài tập</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <h4 class="text-info mb-0">@(classItem.Exams?.Count ?? 0)</h4>
                                <small class="text-muted">Bài kiểm tra</small>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <small class="text-muted d-block mb-2">
                                <i class="fas fa-calendar me-1"></i>
                                @if (classItem.StartDate != null && classItem.EndDate != null)
                                {
                                    <text>@classItem.StartDate.Value.ToString("dd/MM/yyyy") - @classItem.EndDate.Value.ToString("dd/MM/yyyy")</text>
                                }
                                else
                                {
                                    <text>Chưa xác định thời gian</text>
                                }
                            </small>
                            <small class="text-muted">
                                <i class="fas fa-users me-1"></i>
                                Sĩ số: @(classItem.CurrentStudents ?? 0)/@(classItem.MaxStudents ?? 0)
                            </small>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="btn-group w-100 mb-2" role="group">
                            <a href="@Url.Action("ClassDetails", "Teacher", new { id = classItem.ClassId })" 
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-eye me-1"></i>Chi tiết
                            </a>
                            <a href="@Url.Action("ManageStudents", "Teacher", new { classId = classItem.ClassId })" 
                               class="btn btn-success btn-sm">
                                <i class="fas fa-users-cog me-1"></i>Sinh viên
                            </a>
                        </div>
                        <div class="btn-group w-100 mb-2" role="group">
                            <a href="@Url.Action("ClassLessons", "Teacher", new { classId = classItem.ClassId })" 
                               class="btn btn-outline-info btn-sm" title="Quản lý nội dung giảng dạy">
                                <i class="fas fa-book-open me-1"></i>Bài học
                            </a>
                            <a href="@Url.Action("ClassAssignments", "Teacher", new { classId = classItem.ClassId })" 
                               class="btn btn-outline-warning btn-sm" title="Quản lý bài tập">
                                <i class="fas fa-tasks me-1"></i>Bài tập
                            </a>
                            <a href="@Url.Action("ClassExams", "Teacher", new { classId = classItem.ClassId })" 
                               class="btn btn-outline-danger btn-sm" title="Quản lý đề thi">
                                <i class="fas fa-file-alt me-1"></i>Đề thi
                            </a>
                        </div>
                        <div class="btn-group w-100" role="group">
                            <a href="@Url.Action("StudentProgress", "Teacher", new { classId = classItem.ClassId })" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-chart-line me-1"></i>Tiến độ
                            </a>
                            <a href="@Url.Action("SendNotification", "Teacher", new { classId = classItem.ClassId })" 
                               class="btn btn-outline-secondary btn-sm" title="Gửi thông báo">
                                <i class="fas fa-bell me-1"></i>Thông báo
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination justify-content-center">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("MyClasses", new { page = ViewBag.CurrentPage - 1, search = ViewBag.CurrentSearch, facultyId = ViewBag.CurrentFaculty, status = ViewBag.CurrentStatus })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                }

                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("MyClasses", new { page = i, search = ViewBag.CurrentSearch, facultyId = ViewBag.CurrentFaculty, status = ViewBag.CurrentStatus })">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("MyClasses", new { page = ViewBag.CurrentPage + 1, search = ViewBag.CurrentSearch, facultyId = ViewBag.CurrentFaculty, status = ViewBag.CurrentStatus })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-chalkboard fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">Không tìm thấy lớp học nào</h4>
            <p class="text-muted">
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch?.ToString()))
                {
                    <text>Không có lớp học nào phù hợp với từ khóa "<strong>@ViewBag.CurrentSearch</strong>"</text>
                }
                else
                {
                    <text>Bạn chưa được phân công dạy lớp học nào.</text>
                }
            </p>
            <a href="@Url.Action("Index", "Teacher")" class="btn btn-primary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại Dashboard
            </a>
        </div>
    </div>
}

@section Scripts {
<script>
    $(document).ready(function() {
        // Auto-submit search form on enter
        $('input[name="search"]').keypress(function(e) {
            if (e.which == 13) {
                $(this).closest('form').submit();
            }
        });

        // Initialize tooltips
        $('[data-bs-toggle="tooltip"]').tooltip();
    });
</script>
}