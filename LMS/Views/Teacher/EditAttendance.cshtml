@model LMS.Models.Attendance
@{
    ViewData["Title"] = "Chỉnh sửa phiên điểm danh";
    var classInfo = ViewBag.ClassInfo as LMS.Models.Class;
    var lessons = ViewBag.Lessons as List<LMS.Models.Lesson>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Chỉnh sửa phiên điểm danh
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Lớp:</strong> @classInfo.Name (@classInfo.Code)
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" asp-action="EditAttendance">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="attendanceId" value="@Model.AttendanceId" />

                        <div class="mb-3">
                            <label for="title" class="form-label">
                                Tiêu đề phiên điểm danh <span class="text-danger">*</span>
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="title" 
                                   name="title" 
                                   value="@Model.Title"
                                   required 
                                   placeholder="VD: Điểm danh buổi 1, Attendance Week 5, 出席確認..."
                                   maxlength="200">
                            <small class="form-text text-muted">
                                <i class="fas fa-lightbulb"></i> Bạn có thể đặt tiêu đề bằng bất kỳ ngôn ngữ nào (Tiếng Việt, English, 日本語...)
                            </small>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Mô tả (tùy chọn)</label>
                            <textarea class="form-control" 
                                      id="description" 
                                      name="description" 
                                      rows="2" 
                                      maxlength="500"
                                      placeholder="Ghi chú thêm về phiên điểm danh này...">@Model.Description</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="lessonId" class="form-label">Bài học liên quan (tùy chọn)</label>
                            <select class="form-select" id="lessonId" name="lessonId">
                                <option value="">-- Không chọn --</option>
                                @if (lessons != null && lessons.Any())
                                {
                                    @foreach (var lesson in lessons)
                                    {
                                        var isSelected = Model.LessonId == lesson.LessonId;
                                        <option value="@lesson.LessonId" selected="@isSelected">
                                            Tuần @lesson.Week - @lesson.Title
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="startTime" class="form-label">
                                    Thời gian bắt đầu <span class="text-danger">*</span>
                                </label>
                                <input type="datetime-local" 
                                       class="form-control" 
                                       id="startTime" 
                                       name="startTime" 
                                       value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")"
                                       required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="endTime" class="form-label">
                                    Thời gian kết thúc <span class="text-danger">*</span>
                                </label>
                                <input type="datetime-local" 
                                       class="form-control" 
                                       id="endTime" 
                                       name="endTime" 
                                       value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")"
                                       required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       id="allowCodeAttendance" 
                                       name="allowCodeAttendance" 
                                       @(Model.AllowCodeAttendance ? "checked" : "")>
                                <label class="form-check-label" for="allowCodeAttendance">
                                    <i class="fas fa-qrcode me-1"></i> Cho phép điểm danh bằng mã
                                </label>
                                <small class="form-text text-muted d-block ms-4">
                                    Sinh viên có thể tự điểm danh bằng cách nhập mã điểm danh
                                </small>
                            </div>
                        </div>

                        @if (Model.AllowCodeAttendance && !string.IsNullOrEmpty(Model.AttendanceCode))
                        {
                            <div class="alert alert-success mb-3">
                                <i class="fas fa-key me-2"></i>
                                <strong>Mã điểm danh hiện tại:</strong> 
                                <span class="fs-5 fw-bold">@Model.AttendanceCode</span>
                            </div>
                        }

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       id="autoClose" 
                                       name="autoClose" 
                                       @(Model.AutoClose ? "checked" : "")>
                                <label class="form-check-label" for="autoClose">
                                    <i class="fas fa-clock me-1"></i> Tự động đóng khi hết thời gian
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <a href="@Url.Action("ClassDetails", new { id = classInfo.ClassId })" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-1"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
