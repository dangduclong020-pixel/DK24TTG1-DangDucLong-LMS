@model LMS.Models.Class
@{
    Layout = "~/Views/Shared/_LayoutWithSidebar.cshtml";
    ViewBag.Title = "Quản lý Sinh viên";
}

<div class="page-header">
    <div>
        <h1><i class="fas fa-users-cog me-2"></i>Quản lý Sinh viên</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Teacher")">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("MyClasses", "Teacher")">Lớp học</a></li>
                <li class="breadcrumb-item active">Quản lý sinh viên</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Class Info Card -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fas fa-info-circle me-2"></i>Thông tin Lớp học
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Tên lớp:</strong> @Model.Name</p>
                <p><strong>Mã lớp:</strong> <span class="badge bg-primary">@Model.Code</span></p>
                <p><strong>Khóa học:</strong> @Model.Course?.Name</p>
            </div>
            <div class="col-md-6">
                <p><strong>Sĩ số:</strong> <span class="badge bg-info">@(Model.CurrentStudents ?? 0)/@(Model.MaxStudents ?? 0)</span></p>
                <p><strong>Yêu cầu chờ duyệt:</strong> <span class="badge bg-warning" id="pendingCount">@ViewBag.PendingRequests.Count</span></p>
                <a href="@Url.Action("ImportStudents", new { classId = Model.ClassId })" class="btn btn-success btn-sm">
                    <i class="fas fa-file-import me-1"></i>Import Sinh viên
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Pending Join Requests -->
@if (ViewBag.PendingRequests != null && ViewBag.PendingRequests.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="fas fa-clock me-2"></i>Yêu cầu tham gia chờ duyệt
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>MSSV</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Khoa</th>
                            <th>Ngày yêu cầu</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="pendingRequestsTable">
                        @foreach (var request in ViewBag.PendingRequests)
                        {
                            <tr id="request-@request.StudentId">
                                <td><strong>@request.Student.MssvMgv</strong></td>
                                <td>@request.Student.FullName</td>
                                <td>@request.Student.Email</td>
                                <td>@request.Student.Department?.Name</td>
                                <td>@request.EnrollDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-success" onclick="approveRequest(@Model.ClassId, @request.StudentId)">
                                            <i class="fas fa-check"></i> Duyệt
                                        </button>
                                        <button class="btn btn-danger" onclick="rejectRequest(@Model.ClassId, @request.StudentId)">
                                            <i class="fas fa-times"></i> Từ chối
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Students List -->
<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-users me-2"></i>Danh sách Sinh viên (@Model.ClassStudents?.Count ?? 0)
        </h5>
        <input type="text" id="searchStudent" class="form-control form-control-sm w-auto" placeholder="Tìm kiếm sinh viên...">
    </div>
    <div class="card-body">
        @if (Model.ClassStudents != null && Model.ClassStudents.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped" id="studentsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>STT</th>
                            <th>MSSV</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Khoa</th>
                            <th>Ngày tham gia</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }
                        @foreach (var cs in Model.ClassStudents.OrderBy(cs => cs.Student.MssvMgv))
                        {
                            <tr>
                                <td>@index</td>
                                <td><strong>@cs.Student.MssvMgv</strong></td>
                                <td>@cs.Student.FullName</td>
                                <td>@cs.Student.Email</td>
                                <td>@cs.Student.Department?.Name</td>
                                <td>@cs.EnrollDate?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <button class="btn btn-danger btn-sm" onclick="removeStudent(@Model.ClassId, @cs.StudentId, '@cs.Student.FullName')">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle me-2"></i>Chưa có sinh viên nào trong lớp.
                <a href="@Url.Action("ImportStudents", new { classId = Model.ClassId })" class="alert-link">Import sinh viên ngay</a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    // Search students
    $('#searchStudent').on('keyup', function() {
        var value = $(this).val().toLowerCase();
        $('#studentsTable tbody tr').filter(function() {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    });

    // Approve join request
    function approveRequest(classId, studentId) {
        if (!confirm('Bạn có chắc muốn phê duyệt yêu cầu này?')) return;

        $.post('@Url.Action("ApproveJoinRequest", "Teacher")', {
            classId: classId,
            studentId: studentId
        }, function(response) {
            if (response.success) {
                toastr.success(response.message);
                location.reload();
            } else {
                toastr.error(response.message);
            }
        });
    }

    // Reject join request
    function rejectRequest(classId, studentId) {
        if (!confirm('Bạn có chắc muốn từ chối yêu cầu này?')) return;

        $.post('@Url.Action("RejectJoinRequest", "Teacher")', {
            classId: classId,
            studentId: studentId
        }, function(response) {
            if (response.success) {
                toastr.warning(response.message);
                $('#request-' + studentId).fadeOut(300, function() {
                    $(this).remove();
                    updatePendingCount();
                });
            } else {
                toastr.error(response.message);
            }
        });
    }

    // Remove student from class
    function removeStudent(classId, studentId, studentName) {
        if (!confirm(`Bạn có chắc muốn xóa sinh viên "${studentName}" khỏi lớp?`)) return;

        $.post('@Url.Action("RemoveStudent", "Teacher")', {
            classId: classId,
            studentId: studentId
        }, function(response) {
            if (response.success) {
                toastr.success(response.message);
                location.reload();
            } else {
                toastr.error(response.message);
            }
        });
    }

    function updatePendingCount() {
        var count = $('#pendingRequestsTable tr').length;
        $('#pendingCount').text(count);
        if (count === 0) {
            $('.card.mb-4').first().next().fadeOut();
        }
    }
</script>
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.4em 0.6em;
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    #searchStudent {
        max-width: 300px;
    }

    .table th {
        white-space: nowrap;
    }
</style>
