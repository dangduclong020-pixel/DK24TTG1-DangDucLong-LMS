@model List<LMS.Models.SemesterConfig>

@{
    ViewData["Title"] = "Cấu hình học kỳ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-calendar-alt"></i> Cấu hình học kỳ</h2>
        <a href="@Url.Action("CreateSemester")" class="btn btn-success">
            <i class="fas fa-plus"></i> Thêm học kỳ mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Chưa có cấu hình học kỳ nào. Hãy thêm học kỳ mới.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Năm học</th>
                                <th>Học kỳ</th>
                                <th>Tên học kỳ</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Thời lượng</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var semester in Model)
                            {
                                <tr>
                                    <td><strong>@semester.AcademicYear</strong></td>
                                    <td><span class="badge bg-primary">HK @semester.SemesterNumber</span></td>
                                    <td>@semester.SemesterName</td>
                                    <td>@semester.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@semester.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-info">@semester.DurationMonths tháng</span>
                                        <span class="badge bg-secondary">@semester.DurationWeeks tuần</span>
                                    </td>
                                    <td>
                                        @if (semester.IsActive)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Không hoạt động</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("EditSemester", new { id = semester.SemesterConfigId })" 
                                           class="btn btn-sm btn-primary" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button onclick="deleteSemester(@semester.SemesterConfigId)" 
                                                class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-info-circle"></i> Hướng dẫn</h5>
        </div>
        <div class="card-body">
            <p><strong>Cấu hình học kỳ cho năm học:</strong></p>
            <ul>
                <li><strong>Học kỳ 1:</strong> 3 tháng = 12 tuần</li>
                <li><strong>Học kỳ 2:</strong> 3 tháng = 12 tuần</li>
                <li><strong>Học kỳ 3 (Hè):</strong> 2 tháng = 8 tuần</li>
            </ul>
            <p class="text-muted mb-0">
                <i class="fas fa-lightbulb"></i> Lưu ý: Chỉ nên có một học kỳ "Hoạt động" cho mỗi thời điểm.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteSemester(id) {
            if (confirm('Bạn có chắc chắn muốn xóa cấu hình học kỳ này?')) {
                $.ajax({
                    url: '@Url.Action("DeleteSemester")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert('Lỗi: ' + response.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra khi xóa học kỳ');
                    }
                });
            }
        }
    </script>
}
