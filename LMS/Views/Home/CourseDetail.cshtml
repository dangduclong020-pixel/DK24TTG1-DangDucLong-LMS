@model LMS.Models.Class
@using LMS.Models
@{
    Layout = "~/Views/Shared/_LayoutWithSidebar.cshtml";
    ViewBag.Title = $"{Model.Code} - {Model.Course?.Name}";
    var userRole = Context.Session.GetString("UserRole");
    var loggedInUserId = Context.Session.GetString("UserId");
    var isTeacher = !string.IsNullOrEmpty(loggedInUserId) && 
                    int.TryParse(loggedInUserId, out var userId) && 
                    userId == Model.InstructorId;
}

@section Styles {
<style>
    .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #007bff;
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .course-header h1 {
        color: #0056b3;
        border-bottom: 2px solid #0056b3;
        padding-bottom: 10px;
        margin-top: 0;
    }

    .breadcrumb-custom {
        font-size: 0.9em;
        color: #666;
        margin-bottom: 20px;
    }

    .breadcrumb-custom a {
        color: #007bff;
        text-decoration: none;
    }

    .breadcrumb-custom a:hover {
        text-decoration: underline;
    }

    .section {
        margin-bottom: 25px;
    }

    .section h2, .section h3 {
        color: #0056b3;
    }

    .course-description, .course-objectives {
        line-height: 1.6;
    }

    .course-description h1, .course-description h2, .course-description h3,
    .course-objectives h1, .course-objectives h2, .course-objectives h3 {
        margin-top: 15px;
        margin-bottom: 10px;
    }

    .course-description ul, .course-description ol,
    .course-objectives ul, .course-objectives ol {
        margin-left: 20px;
        margin-bottom: 10px;
    }

    .course-description p, .course-objectives p {
        margin-bottom: 10px;
    }

    .lesson-content-html {
        line-height: 1.6;
    }

    .lesson-content-html h1, .lesson-content-html h2, .lesson-content-html h3 {
        margin-top: 15px;
        margin-bottom: 10px;
        color: #0056b3;
    }

    .lesson-content-html ul, .lesson-content-html ol {
        margin-left: 20px;
        margin-bottom: 10px;
    }

    .lesson-content-html p {
        margin-bottom: 10px;
    }

    .info-box {
        border-left: 4px solid #0056b3;
        padding-left: 15px;
        background: #f0f7ff;
        padding: 10px 15px;
        margin-top: 10px;
    }

    .info-box p {
        margin: 8px 0;
    }

    /* Video Button Styles */
    .video-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .video-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    .video-btn i {
        font-size: 18px;
    }

    /* Modal Styles */
    .video-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
        animation: fadeIn 0.3s ease;
    }

    .video-modal-content {
        position: relative;
        margin: 2% auto;
        width: 70%;
        max-width: 900px;
        animation: slideDown 0.3s ease;
    }

    .video-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background: #333;
        color: white;
        border-radius: 8px 8px 0 0;
    }

    .video-modal-header h3 {
        margin: 0;
        font-size: 18px;
    }

    .modal-close {
        color: white;
        font-size: 32px;
        font-weight: bold;
        cursor: pointer;
        background: none;
        border: none;
        line-height: 1;
        transition: color 0.3s;
    }

    .modal-close:hover {
        color: #ff4444;
    }

    .video-modal-body {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        background: #000;
        border-radius: 0 0 8px 8px;
    }

    .video-modal-body iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
        border-radius: 0 0 8px 8px;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Chapter Styles */
    .chapter-card {
        border: 1px solid #ddd;
        margin-bottom: 15px;
        border-radius: 5px;
        overflow: hidden;
    }

    .chapter-header {
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .chapter-header:hover {
        opacity: 0.9;
    }

    .chapter-header h3 {
        margin: 0;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
    }

    .bg-gray { background-color: #e9ecef; }
    .bg-red { background-color: #ffe3e3; color: #d93025; }
    .bg-blue { background-color: #e3f2fd; color: #1976d2; }
    .bg-green { background-color: #e8f5e9; color: #388e3c; }
    .bg-orange { background-color: #fff3e0; color: #f57c00; }

    .chapter-content {
        padding: 15px 25px;
        border-top: 1px solid #ddd;
        display: block;
    }

    .chapter-content.collapsed {
        display: none;
    }

    .resource-list {
        list-style: none;
        padding: 0;
        margin: 10px 0;
    }

    .resource-list li {
        padding: 8px 0;
        border-bottom: 1px dashed #eee;
    }

    .resource-list li:last-child {
        border-bottom: none;
    }

    .resource-list a {
        color: #007bff;
        text-decoration: none;
    }

    .resource-list a:hover {
        text-decoration: underline;
    }

    .text-blue { color: #007bff; }
    .text-green { color: #28a745; }
    .text-orange { color: #fd7e14; }
    .text-red { color: #dc3545; }

    .learning-outcomes {
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }

    .learning-outcomes h4 {
        margin-bottom: 10px;
        color: #555;
        font-size: 1rem;
    }

    .learning-outcomes ul {
        margin: 5px 0;
        padding-left: 20px;
    }

    .learning-outcomes li {
        margin-bottom: 5px;
    }

    .complete-check {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .expand-icon {
        transition: transform 0.3s ease;
        margin-left: 10px;
    }

    .expand-icon.rotated {
        transform: rotate(180deg);
    }

    /* Mission Section Styles */
    .mission-section {
        background: #f8f9fa;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 0;
        margin-top: 30px;
    }

    .mission-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 15px 20px;
        border-radius: 6px 6px 0 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .mission-header i {
        font-size: 24px;
    }

    .mission-header h4 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


    /* Edit Button Styles */
    .btn-edit-inline {
        margin-left: 15px;
        color: #007bff;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }

    .btn-edit-inline:hover {
        color: #0056b3;
    }

    .btn-edit-icon {
        color: #ffc107;
        text-decoration: none;
        font-size: 1rem;
        padding: 5px 8px;
        border-radius: 4px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-edit-icon:hover {
        background: rgba(255, 193, 7, 0.2);
        color: #ff9800;
    }

    .btn-edit-small {
        color: #007bff;
        text-decoration: none;
        font-size: 0.9rem;
        padding: 4px 8px;
        border-radius: 4px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
    }

    .btn-edit-small:hover {
        background: rgba(0, 123, 255, 0.1);
        color: #0056b3;
    }

    .btn-add-icon {
        color: white;
        text-decoration: none;
        font-size: 1.2rem;
        padding: 5px;
        border-radius: 4px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
    }

    .btn-add-icon:hover {
        opacity: 0.8;
        transform: scale(1.1);
    }

    /* Teacher Dropdown Styles */
    .dropdown-toggle-custom {
        background: white;
        border: 2px solid #6c757d;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .dropdown-toggle-custom:hover {
        background: #6c757d;
        color: white;
        transform: rotate(90deg);
        border-color: #6c757d;
    }

    .dropdown-toggle-custom i {
        font-size: 18px;
    }

    .dropdown-menu-custom {
        position: absolute;
        top: 45px;
        right: 0;
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        min-width: 250px;
        z-index: 1000;
        padding: 8px 0;
        border: 1px solid #e0e0e0;
    }

    .dropdown-item-custom {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 20px;
        width: 100%;
        text-align: left;
        border: none;
        background: white;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 14px;
        color: #333;
    }

    .dropdown-item-custom:hover {
        background: #f8f9fa;
    }

    .dropdown-item-custom i {
        font-size: 16px;
        width: 20px;
        text-align: center;
    }

    .dropdown-divider-custom {
        height: 1px;
        background: #e0e0e0;
        margin: 8px 0;
    }

    /* Edit Mode Styles */
    body:not(.edit-mode) .edit-control {
        display: none !important;
    }

    .edit-mode-indicator {
        position: fixed;
        top: 80px;
        right: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 10px 20px;
        border-radius: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        z-index: 999;
        display: none;
        align-items: center;
        gap: 10px;
        animation: slideIn 0.3s ease;
    }

    body.edit-mode .edit-mode-indicator {
        display: flex;
    }

    @@keyframes slideIn {
        from {
            transform: translateX(100%);
        }
        to {
            transform: translateX(0);
        }
    }

    .edit-mode .dropdown-item-custom.edit-mode-toggle {
        background: #e8f5e9;
        color: #2e7d32;
        font-weight: bold;
    }
</style>
}

<a href="@(userRole == "Teacher" || userRole == "Instructor" ? Url.Action("MyClasses", "Teacher") : Url.Action("MyCourses", "Home"))" class="back-link">
    <i class="fas fa-arrow-left"></i> Quay lại danh sách khóa học
</a>

<header class="course-header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <h1 id="className">@Model.Name</h1>
            @if (isTeacher || userRole?.ToLower() == "teacher" || userRole?.ToLower() == "instructor" || userRole?.ToLower() == "giảng viên")
            {
                <button type="button" 
                        class="btn btn-sm btn-warning edit-control" 
                        onclick="openEditClassTitleModal('@Model.ClassId', '@(Model.Code?.Replace("'", "\\'")){12}', '@(Model.Course?.Code?.Replace("'", "\\'"))' , '@(Model.Course?.Name?.Replace("'", "\\'"))' , '@(Model.Name?.Replace("'", "\\'"))')"
                        title="Tùy chỉnh tên lớp">
                    <i class="fas fa-edit"></i> Sửa tên
                </button>
            }
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            @* Nút điểm danh cho sinh viên *@
            @if (!(isTeacher || userRole?.ToLower() == "teacher" || userRole?.ToLower() == "instructor" || userRole?.ToLower() == "giảng viên"))
            {
                <a href="@Url.Action("StudentAttendance", "Home", new { classId = Model.ClassId })" 
                   class="btn btn-primary btn-sm"
                   title="Xem và điểm danh">
                    <i class="fas fa-user-check"></i> Điểm danh
                </a>
            }
            
            @if (isTeacher || userRole?.ToLower() == "teacher" || userRole?.ToLower() == "instructor" || userRole?.ToLower() == "giảng viên")
            {
                <div class="dropdown d-inline-block">
                    <button type="button" 
                            class="btn btn-outline-secondary btn-sm dropdown-toggle-custom" 
                            id="teacherActionsDropdown"
                            onclick="toggleTeacherDropdown(event)"
                            title="Quản lý khóa học">
                        <i class="fas fa-cog"></i>
                    </button>
                    <div class="dropdown-menu-custom" id="teacherDropdownMenu" style="display: none;">
                        <button type="button" class="dropdown-item-custom edit-mode-toggle" onclick="toggleEditMode()">
                            <i class="fas fa-edit text-success"></i>
                            <span id="editModeButtonText">Bật chế độ chỉnh sửa</span>
                        </button>
                        <div class="dropdown-divider-custom"></div>
                        <button type="button" class="dropdown-item-custom" onclick="window.location.href='@Url.Action("GradeManagement", "Teacher", new { id = Model.ClassId })'">
                            <i class="fas fa-chart-line text-primary"></i> Quản lý điểm
                        </button>
                        <button type="button" class="dropdown-item-custom" onclick="exportToExcel()">
                            <i class="fas fa-file-excel text-success"></i> Xuất danh sách SV
                        </button>
                        <button type="button" class="dropdown-item-custom" onclick="window.location.href='@Url.Action("ManageStudents", "Teacher", new { classId = Model.ClassId })'">
                            <i class="fas fa-users text-info"></i> Quản lý sinh viên
                        </button>
                        <button type="button" class="dropdown-item-custom" onclick="window.location.href='@Url.Action("SendNotification", "Teacher", new { classId = Model.ClassId })'">
                            <i class="fas fa-bell text-warning"></i> Gửi thông báo
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
    <nav class="breadcrumb-custom">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a> / 
        <a href="#">Khối đào tạo</a> / 
        <a href="#">@(Model.Course?.Faculty?.Name ?? "Khoa")</a> / 
        @Model.Course?.Name
    </nav>
</header>
</header>

<!-- Edit Mode Indicator -->
<div class="edit-mode-indicator">
    <i class="fas fa-edit"></i>
    <span>Chế độ chỉnh sửa đang BẬT</span>
    <button type="button" onclick="toggleEditMode()" style="background: rgba(255,255,255,0.3); border: 1px solid white; color: white; padding: 5px 15px; border-radius: 15px; cursor: pointer; margin-left: 10px;">
        <i class="fas fa-times"></i> Tắt
    </button>
</div>

<section class="section overview">
    <h2>
        <i class="fas fa-book-open"></i> TỔNG QUAN KHÓA HỌC
        @if (userRole == "Teacher" || userRole == "Instructor")
        {
            <a href="@Url.Action("EditClass", "Teacher", new { id = Model.ClassId })" class="btn-edit-inline edit-control" title="Chỉnh sửa tổng quan">
                <i class="fas fa-edit"></i>
            </a>
        }
    </h2>
    
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="course-description">
            @Html.Raw(Model.Description)
        </div>
    }
    else
    {
        <p>Mô tả học phần sẽ được cập nhật sớm.</p>
    }
    
    @if (!string.IsNullOrEmpty(Model.Objectives))
    {
        <div class="course-objectives mt-3">
            <strong>Mục tiêu:</strong>
            @Html.Raw(Model.Objectives)
        </div>
    }
    
    @* Hiển thị tất cả các section (OrderNumber = 0) *@
    @{
        // Lấy tất cả các section có OrderNumber = 0 (bao gồm điểm danh, tài liệu, video...)
        var lessonSections = Model.Lessons?.Where(l => l.OrderNumber == 0)
                                .OrderBy(l => l.CreatedAt).ToList();
    }
    
    @if (lessonSections != null && lessonSections.Any())
    {
        foreach (var lessonSection in lessonSections)
        {
            var lessonAttendances = Model.Attendances?.Where(a => a.LessonId == lessonSection.LessonId).OrderByDescending(a => a.StartTime).ToList();
            var lessonFiles = lessonSection.LessonFiles?.OrderBy(f => f.FileId).ToList();
            var hasContent = (lessonAttendances != null && lessonAttendances.Any()) || (lessonFiles != null && lessonFiles.Any()) || !string.IsNullOrEmpty(lessonSection.VideoUrl);
            
            // Kiểm tra xem section có phải là section điểm danh không (title chứa "điểm danh" hoặc "attendance")
            var isAttendanceSection = lessonSection.Title.ToLower().Contains("điểm danh") || lessonSection.Title.ToLower().Contains("attendance");
            
            <div class="mt-4 mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="mb-0">
                        @if (userRole == "Teacher" || userRole == "Instructor")
                        {
                            @if (isAttendanceSection)
                            {
                                <a href="@Url.Action("ManageAttendance", "Teacher", new { lessonId = lessonSection.LessonId })" 
                                   style="color: inherit; text-decoration: none; display: flex; align-items: center; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
                                   onmouseover="this.style.transform='translateX(5px)'; this.style.boxShadow='0 4px 12px rgba(102, 126, 234, 0.4)';"
                                   onmouseout="this.style.transform='translateX(0)'; this.style.boxShadow='none';">
                                    @Html.Raw(lessonSection.Title)
                                    <span class="badge bg-light text-dark ms-2" style="font-size: 0.7rem;">Click để quản lý</span>
                                    <i class="fas fa-arrow-right ms-2" style="font-size: 0.9rem;"></i>
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("ManageAttendance", "Teacher", new { lessonId = lessonSection.LessonId })" style="color: inherit; text-decoration: none;">
                                    @Html.Raw(lessonSection.Title)
                                </a>
                            }
                        }
                        else
                        {
                            @if (isAttendanceSection)
                            {
                                <a href="@Url.Action("StudentAttendance", "Home", new { classId = Model.ClassId })" 
                                   style="color: inherit; text-decoration: none; display: flex; align-items: center; padding: 8px 12px; border-radius: 8px; transition: all 0.3s ease; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
                                   onmouseover="this.style.transform='translateX(5px)'; this.style.boxShadow='0 4px 12px rgba(102, 126, 234, 0.4)';"
                                   onmouseout="this.style.transform='translateX(0)'; this.style.boxShadow='none';">
                                    @Html.Raw(lessonSection.Title)
                                    <span class="badge bg-light text-dark ms-2" style="font-size: 0.7rem;">Click để xem</span>
                                    <i class="fas fa-arrow-right ms-2" style="font-size: 0.9rem;"></i>
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("StudentAttendance", "Home", new { classId = Model.ClassId })" style="color: inherit; text-decoration: none;">
                                    @Html.Raw(lessonSection.Title)
                                </a>
                            }
                        }
                    </h5>
                    @if (userRole == "Teacher" || userRole == "Instructor")
                    {
                        @if (!isAttendanceSection)
                        {
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm btn-success dropdown-toggle edit-control" data-bs-toggle="dropdown" title="Thêm nội dung">
                                <i class="fas fa-plus"></i> Thêm
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <button class="dropdown-item" onclick="showAddSlideModalForSection(@lessonSection.LessonId)">
                                        <i class="fas fa-file text-primary"></i> Thêm tài liệu
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" onclick="showAddVideoModalForSection(@lessonSection.LessonId)">
                                        <i class="fas fa-video text-danger"></i> Thêm video
                                    </button>
                                </li>
                            </ul>
                            <button onclick="showEditResourceTitleModal(@lessonSection.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lessonSection.Title))')" 
                                    class="btn btn-sm btn-secondary edit-control" title="Sửa tiêu đề section">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteSection(@lessonSection.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lessonSection.Title))', @(hasContent ? "true" : "false"))" 
                                    class="btn btn-sm btn-danger edit-control" title="Xóa section">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        }
                        else
                        {
                            <button onclick="showEditResourceTitleModal(@lessonSection.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lessonSection.Title))')" 
                                    class="btn btn-sm btn-secondary edit-control me-2" title="Sửa tiêu đề section">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteSection(@lessonSection.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lessonSection.Title))', @(hasContent ? "true" : "false"))" 
                                    class="btn btn-sm btn-danger edit-control" title="Xóa section">
                                <i class="fas fa-trash"></i>
                            </button>
                        }
                    }
                </div>
                
                @* Chỉ hiển thị nội dung nếu KHÔNG phải section điểm danh *@
                @if (!isAttendanceSection)
                {
                @if (!string.IsNullOrEmpty(lessonSection.VideoUrl))
                {
                    <div class="mb-2">
                        <button onclick="openVideoModal('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lessonSection.Title))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lessonSection.VideoUrl))')" class="video-btn">
                            <i class="fas fa-play-circle"></i>
                            Xem video bài giảng
                        </button>
                    </div>
                }
                
                @* Hiển thị tài liệu nếu có *@
                @if (lessonFiles != null && lessonFiles.Any())
                {
                    <ul class="resource-list" style="list-style: none; padding-left: 0;">
                        @foreach (var file in lessonFiles)
                        {
                            <li class="mb-2 d-flex align-items-center justify-content-between">
                                <div>
                                    <a href="@file.FilePath" target="_blank">@Html.Raw(file.FileName)</a>
                                </div>
                                @if (userRole == "Teacher" || userRole == "Instructor")
                                {
                                    <div>
                                        <button onclick="showEditFileModal(@file.FileId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(file.FileName))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(file.FilePath))')" class="btn btn-sm btn-warning me-1 edit-control">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button onclick="deleteFile(@file.FileId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(file.FileName))')" class="btn btn-sm btn-danger edit-control">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                
                @* Hiển thị phiên điểm danh nếu có - hiển thị đơn giản như tài liệu *@
                @if (lessonAttendances != null && lessonAttendances.Any())
                {
                    <ul class="resource-list" style="list-style: none; padding-left: 0;">
                        @foreach (var attendance in lessonAttendances)
                        {
                            <li class="mb-2 d-flex align-items-center justify-content-between">
                                <div>
                                    <i class="fas fa-clipboard-check text-success"></i>
                                    @if (userRole == "Teacher" || userRole == "Instructor")
                                    {
                                        <a href="@Url.Action("ManageAttendance", "Teacher", new { lessonId = lessonSection.LessonId })">
                                            @Html.Raw(attendance.Title)
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("StudentAttendance", "Home", new { classId = Model.ClassId })">
                                            @Html.Raw(attendance.Title)
                                        </a>
                                    }
                                </div>
                                @if (userRole == "Teacher" || userRole == "Instructor")
                                {
                                    <div>
                                        <button onclick="deleteAttendance(@attendance.AttendanceId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(attendance.Title))')" class="btn btn-sm btn-danger edit-control">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                
                @* Thông báo nếu section trống *@
                @if (!hasContent)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Chưa có nội dung nào trong section này.
                        @if (userRole == "Teacher" || userRole == "Instructor")
                        {
                            <span class="alert-link">Nhấn nút "Thêm" ở trên để thêm nội dung.</span>
                        }
                    </div>
                }
                } @* Đóng if (!isAttendanceSection) *@
            </div>
        }
    }
    
    @* Hiển thị các hoạt động không thuộc chương nào (LessonId = null) *@
    @{
        var generalUserIdStr2 = Context.Session.GetString("UserId");
        int.TryParse(generalUserIdStr2, out var generalCurrentUserId2);
        
        var generalAssignments = Model.Assignments?.Where(a => a.LessonId == null && a.DeletedAt == null && (a.IsPublished == true || userRole == "Teacher" || userRole == "Instructor")).OrderByDescending(a => a.DueDate).ToList();
        var generalExams = Model.Exams?.Where(e => e.LessonId == null && e.DeletedAt == null).OrderByDescending(e => e.StartTime).ToList();
        var generalAttendances = Model.Attendances?.Where(at => at.LessonId == null).OrderByDescending(at => at.StartTime).ToList();
        
        var hasGeneralActivities = (generalAssignments != null && generalAssignments.Any()) || 
                                   (generalExams != null && generalExams.Any()) || 
                                   (generalAttendances != null && generalAttendances.Any());
    }
    
    @if (hasGeneralActivities)
    {
        <div class="mt-4 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0" style="display: flex; align-items: center;">
                    <i class="fas fa-list-check me-2" style="color: #007bff;"></i>
                    Hoạt Động
                </h5>
            </div>
            @* Hiển thị bài tập *@
            @if (generalAssignments != null && generalAssignments.Any())
            {
                foreach (var assignment in generalAssignments)
                {
                    var hasSubmitted = assignment.Submissions?.Any(s => s.StudentId == generalCurrentUserId2) ?? false;
                    
                    <div class="assignment-item mb-3 p-3" style="border: 1px solid #e0e0e0; border-radius: 8px; background: white;">
                        <div class="d-flex align-items-start gap-3">
                            <div>
                                <input type="checkbox" @(hasSubmitted ? "checked" : "") disabled style="width: 20px; height: 20px;" />
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-file-alt" style="color: #ff6b6b;"></i>
                                    <h6 class="mb-0">
                                        <a href="@Url.Action("AssignmentDetail", "Home", new { id = assignment.AssignmentId })" style="color: #0066cc; text-decoration: none;">
                                            @assignment.Title
                                        </a>
                                        <span class="badge bg-success ms-2">Bài tập</span>
                                        @if (assignment.IsPublished != true && (userRole == "Teacher" || userRole == "Instructor"))
                                        {
                                            <span class="badge bg-warning text-dark ms-2">Nháp</span>
                                        }
                                    </h6>
                                </div>
                                <div style="font-size: 0.9em; color: #666;">
                                    <i class="fas fa-clock"></i> Hạn nộp: @assignment.DueDate.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                            <div>
                                @if (userRole == "Teacher" || userRole == "Instructor")
                                {
                                    <a href="@Url.Action("EditAssignment", "Teacher", new { id = assignment.AssignmentId })" class="btn btn-sm btn-warning me-2 edit-control">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button onclick="deleteAssignment(@assignment.AssignmentId, '@assignment.Title')" class="btn btn-sm btn-danger edit-control">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            
            @* Hiển thị kiểm tra *@
            @if (generalExams != null && generalExams.Any())
            {
                foreach (var exam in generalExams)
                {
                    var examResult = exam.ExamResults?.FirstOrDefault(er => er.StudentId == generalCurrentUserId2);
                    var hasCompleted = examResult != null;
                    
                    <div class="assignment-item mb-3 p-3" style="border: 1px solid #e0e0e0; border-radius: 8px; background: white;">
                        <div class="d-flex align-items-start gap-3">
                            <div>
                                <input type="checkbox" @(hasCompleted ? "checked" : "") disabled style="width: 20px; height: 20px;" />
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fas fa-file-alt" style="color: #4CAF50;"></i>
                                    <h6 class="mb-0">
                                        <a href="@Url.Action("ExamDetail", "Home", new { id = exam.ExamId })" style="color: #0066cc; text-decoration: none;">
                                            @exam.Title
                                        </a>
                                        <span class="badge bg-info ms-2">Kiểm tra</span>
                                    </h6>
                                </div>
                                <div style="font-size: 0.9em; color: #666;">
                                    <i class="fas fa-clock"></i> @exam.StartTime.ToString("dd/MM/yyyy HH:mm") - @exam.EndTime.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                            <div>
                                @if (userRole == "Teacher" || userRole == "Instructor")
                                {
                                    <a href="@Url.Action("EditExam", "Teacher", new { id = exam.ExamId })" class="btn btn-sm btn-warning me-2 edit-control">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button onclick="deleteExam(@exam.ExamId, '@exam.Title')" class="btn btn-sm btn-danger edit-control">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            
            @* Hiển thị mục điểm danh tổng hợp *@
            @if (generalAttendances != null && generalAttendances.Any())
            {
                var totalAttendances = generalAttendances.Count();
                var openAttendances = generalAttendances.Count(a => a.Status != "Closed");
                var totalStudents = Model.ClassStudents?.Count() ?? 0;
                
                // Tính tỉ lệ điểm danh trung bình cho sinh viên
                int myPresentCount = 0;
                if (userRole == "Student")
                {
                    foreach (var att in generalAttendances)
                    {
                        var myRecord = att.AttendanceRecords?.FirstOrDefault(ar => ar.StudentId == generalCurrentUserId2);
                        if (myRecord?.Status == "Present")
                        {
                            myPresentCount++;
                        }
                    }
                }
                
                <div class="assignment-item mb-3 p-3" style="border: 1px solid #e0e0e0; border-radius: 8px; background: white;">
                    <div class="d-flex align-items-start gap-3">
                        <div>
                            @if (userRole == "Student")
                            {
                                <input type="checkbox" @(myPresentCount > 0 ? "checked" : "") disabled style="width: 20px; height: 20px;" />
                            }
                            else
                            {
                                <i class="fas fa-user-check" style="font-size: 20px; color: #28a745;"></i>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <h6 class="mb-0">
                                    <a href="@Url.Action("StudentAttendance", "Home", new { classId = Model.ClassId })" style="color: #0066cc; text-decoration: none;">
                                        Điểm danh
                                    </a>
                                    <span class="badge bg-warning text-dark ms-2">@totalAttendances buổi</span>
                                    @if (openAttendances > 0)
                                    {
                                        <span class="badge bg-success ms-2">@openAttendances đang mở</span>
                                    }
                                </h6>
                            </div>
                            <div class="d-flex align-items-center gap-3" style="font-size: 0.9em; color: #666;">
                                @if (userRole == "Student")
                                {
                                    var attendancePercent = totalAttendances > 0 ? (myPresentCount * 100.0 / totalAttendances) : 0;
                                    <span><i class="fas fa-chart-line"></i> Bạn đã điểm danh: @myPresentCount/@totalAttendances buổi (@attendancePercent.ToString("F1")%)</span>
                                }
                                else if (userRole == "Teacher" || userRole == "Instructor")
                                {
                                    <span><i class="fas fa-calendar-check"></i> Tổng số buổi: @totalAttendances</span>
                                    @if (openAttendances > 0)
                                    {
                                        <span><i class="fas fa-clock"></i> @openAttendances buổi đang mở</span>
                                    }
                                }
                            </div>
                            <p class="mt-2 mb-0" style="font-size: 0.9em; color: #555;">
                                Click để xem chi tiết tất cả các buổi điểm danh và thực hiện điểm danh
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    @* Menu quản lý khóa học - chỉ giảng viên thấy (đặt ở cuối session) *@
    @if (userRole == "Teacher" || userRole == "Instructor")
    {
        <div class="mt-4 edit-control">
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-lg" type="button" id="courseManagementMenu" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-cog"></i> Quản lý khóa học
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="courseManagementMenu" style="min-width: 280px;">
                    <li><h6 class="dropdown-header"><i class="fas fa-graduation-cap"></i> Thêm Hoạt Động</h6></li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="createAndGoToAttendance(); return false;">
                            <i class="fas fa-user-check text-success"></i> Tạo section Điểm danh
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("CreateAssignment", "Teacher", new { classId = Model.ClassId })">
                            <i class="fas fa-tasks text-primary"></i> Tạo bài tập mới
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("CreateExam", "Teacher", new { classId = Model.ClassId })">
                            <i class="fas fa-file-alt text-info"></i> Tạo bài kiểm tra
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="showCreateSectionModal(); return false;">
                            <i class="fas fa-folder-plus text-warning"></i> Tạo section mới
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header"><i class="fas fa-book"></i> Tài Nguyên Học Tập</h6></li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="showAddSlideModal(); return false;">
                            <i class="fas fa-info-circle text-primary"></i> Thêm thông tin khóa học
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("EditClass", "Teacher", new { id = Model.ClassId })">
                            <i class="fas fa-edit text-secondary"></i> Chỉnh sửa thông tin lớp
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("CreateLesson", "Teacher", new { classId = Model.ClassId })">
                            <i class="fas fa-folder-plus text-dark"></i> Thêm chương/bài học
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }
</section>

<!-- Nội dung chính cần xem lại / Mission Section -->
<section class="mission-section mt-4 mb-4">
    <div class="mission-header">
        <i class="fas fa-bullseye"></i>
        <h4 id="missionTitle">@(string.IsNullOrEmpty(Model.MissionTitle) ? "NỘI DUNG CHÍNH CẦN XEM LẠI" : Model.MissionTitle)</h4>
        @if (isTeacher || userRole?.ToLower() == "teacher" || userRole?.ToLower() == "instructor" || userRole?.ToLower() == "giảng viên")
        {
            <button onclick="openEditMissionTitleModal()" class="btn btn-sm btn-warning ms-2 edit-control" title="Sửa tiêu đề Mission">
                <i class="fas fa-edit"></i> Sửa
            </button>
        }
    </div>
    
    <div class="mission-content">
        <!-- Lessons / Chapters -->
        @if (Model.Lessons != null && Model.Lessons.Any())
        {
            var chapterColors = new[] { "bg-gray", "bg-blue", "bg-green", "bg-orange" };
            var chapterIndex = 0;

    foreach (var lesson in Model.Lessons.Where(l => l.OrderNumber != 0).OrderBy(l => l.OrderNumber))
    {
        var colorClass = chapterColors[chapterIndex % chapterColors.Length];
        chapterIndex++;

        <div class="chapter-card mb-3">
            <div class="chapter-content" style="display: block;">
                @if (isTeacher || userRole?.ToLower() == "teacher" || userRole?.ToLower() == "instructor" || userRole?.ToLower() == "giảng viên")
                {
                    <!-- Teacher Controls - Only visible in edit mode -->
                    <div class="mb-3 p-2 border-bottom edit-control" style="background-color: #f8f9fa;">
                        <button onclick="showAddVideoModal(@lesson.LessonId);" class="btn btn-sm btn-primary me-2">
                            <i class="fas fa-video"></i> Thêm video
                        </button>
                        <button onclick="showEditLessonContentModal(@lesson.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lesson.Title))');" class="btn btn-sm btn-info me-2" title="Sửa nội dung chương">
                            <i class="fas fa-file-edit"></i> Sửa nội dung
                        </button>
                        <button onclick="showEditLessonTitleModal(@lesson.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lesson.Title))');" class="btn btn-sm btn-warning me-2" title="Sửa tên chương">
                            <i class="fas fa-edit"></i> Sửa tên
                        </button>
                        <button onclick="deleteLesson(@lesson.LessonId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(lesson.Title))');" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(lesson.Content))
                {
                    <div class="lesson-content-html">
                        @Html.Raw(lesson.Content)
                    </div>
                }
                else
                {
                    <p style="color: #6c757d; font-style: italic;">Nội dung bài học chưa được cập nhật.</p>
                }

                @* Hiển thị video bài giảng của chương *@
                @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                {
                    <div class="mt-4 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <h5 class="mb-0"><i class="fas fa-video text-danger"></i> Video Bài Giảng</h5>
                            <button class="video-btn" onclick="openVideoModal('Video Bài Giảng - @lesson.Title', '@lesson.VideoUrl')">
                                <i class="fas fa-play-circle"></i>
                                Xem video
                            </button>
                        </div>
                    </div>
                }

                @if (lesson.LessonFiles != null && lesson.LessonFiles.Any())
                {
                    <div class="mt-3">
                        <strong><i class="fas fa-paperclip"></i> Tài liệu đính kèm:</strong>
                        <ul class="resource-list">
                            @foreach (var file in lesson.LessonFiles)
                            {
                                <li>
                                    <a href="@file.FilePath" target="_blank">@Html.Raw(file.FileName)</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                
                @* Hiển thị bài tập của chương này *@
                @{
                    var lessonAssignments = Model.Assignments?.Where(a => a.LessonId == lesson.LessonId && a.DeletedAt == null && (a.IsPublished == true || userRole == "Teacher" || userRole == "Instructor")).OrderBy(a => a.DueDate).ToList();
                    var userIdStr = Context.Session.GetString("UserId");
                    int.TryParse(userIdStr, out var currentUserId);
                }
                @if (lessonAssignments != null && lessonAssignments.Any())
                {
                    <div class="mt-4">
                        <h5 class="mb-3"><i class="fas fa-tasks text-primary"></i> Bài tập</h5>
                        <div class="assignment-list">
                            @foreach (var assignment in lessonAssignments)
                            {
                                var hasSubmitted = assignment.Submissions?.Any(s => s.StudentId == currentUserId) ?? false;
                                var isOverdue = DateTime.Now > assignment.DueDate;
                                
                                <div class="assignment-item mb-3 p-3" style="border: 1px solid #e0e0e0; border-radius: 8px; background: white; @(assignment.IsPublished != true && (userRole == "Teacher" || userRole == "Instructor") ? "opacity: 0.6; border: 2px dashed #ffc107;" : "")">
                                    <div class="d-flex align-items-start gap-3">
                                        <div>
                                            <input type="checkbox" @(hasSubmitted ? "checked" : "") disabled style="width: 20px; height: 20px; cursor: pointer;" />
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fas fa-file-alt" style="color: #ff6b6b;"></i>
                                                <h6 class="mb-0">
                                                    <a href="@Url.Action("AssignmentDetail", "Home", new { id = assignment.AssignmentId })" style="color: #0066cc; text-decoration: none;">
                                                        @assignment.Title
                                                    </a>
                                                    @if (assignment.IsPublished != true && (userRole == "Teacher" || userRole == "Instructor"))
                                                    {
                                                        <span class="badge bg-warning text-dark ms-2">Nháp</span>
                                                    }
                                                </h6>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            @if (userRole == "Teacher" || userRole == "Instructor")
                                            {
                                                @if (assignment.IsPublished != true)
                                                {
                                                    <form method="post" action="@Url.Action("TogglePublishAssignment", "Teacher")" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="assignmentId" value="@assignment.AssignmentId" />
                                                        <input type="hidden" name="isPublished" value="true" />
                                                        <button type="submit" class="btn btn-sm btn-success" title="Công bố bài tập">
                                                            <i class="fas fa-eye"></i> Công bố
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" action="@Url.Action("TogglePublishAssignment", "Teacher")" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="assignmentId" value="@assignment.AssignmentId" />
                                                        <input type="hidden" name="isPublished" value="false" />
                                                        <button type="submit" class="btn btn-sm btn-secondary" title="Ẩn bài tập">
                                                            <i class="fas fa-eye-slash"></i> Ẩn
                                                        </button>
                                                    </form>
                                                }
                                                <a href="@Url.Action("EditAssignment", "Teacher", new { id = assignment.AssignmentId })" 
                                                   class="btn btn-sm btn-warning edit-control">
                                                    <i class="fas fa-edit"></i> Sửa
                                                </a>
                                                <button onclick="deleteAssignment(@assignment.AssignmentId, '@assignment.Title')" 
                                                        class="btn btn-sm btn-danger edit-control" title="Xóa bài tập">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("AssignmentDetail", "Home", new { id = assignment.AssignmentId })" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="fas fa-info-circle"></i> Chi tiết
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                
                @* Hiển thị bài kiểm tra của chương này *@
                @{
                    var lessonExams = Model.Exams?.Where(e => e.LessonId == lesson.LessonId && e.DeletedAt == null).OrderBy(e => e.StartTime).ToList();
                }
                @if (lessonExams != null && lessonExams.Any())
                {
                    @foreach (var exam in lessonExams)
                    {
                        var examResult = exam.ExamResults?.FirstOrDefault(er => er.StudentId == currentUserId);
                        var hasCompleted = examResult != null;
                        
                        <div class="assignment-item mb-3 p-3" style="border: 1px solid #e0e0e0; border-radius: 8px; background: white;">
                            <div class="d-flex align-items-start gap-3">
                                <div>
                                    <input type="checkbox" @(hasCompleted ? "checked" : "") disabled style="width: 20px; height: 20px; cursor: pointer;" />
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="fas fa-file-alt" style="color: #4CAF50;"></i>
                                        <h6 class="mb-0">
                                            <a href="@Url.Action("ExamDetail", "Home", new { id = exam.ExamId })" style="color: #0066cc; text-decoration: none;">
                                                @exam.Title
                                            </a>
                                        </h6>
                                    </div>
                                    
                                </div>
                                <div>
                                    @if (userRole == "Teacher" || userRole == "Instructor")
                                    {
                                        <a href="@Url.Action("EditExam", "Teacher", new { id = exam.ExamId })" 
                                           class="btn btn-sm btn-warning me-2 edit-control">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <button onclick="deleteExam(@exam.ExamId, '@exam.Title')" 
                                                class="btn btn-sm btn-danger edit-control" title="Xóa bài kiểm tra">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ExamDetail", "Home", new { id = exam.ExamId })" 
                                           class="btn btn-sm @(hasCompleted ? "btn-success" : "btn-primary")">
                                            <i class="fas @(hasCompleted ? "fa-check" : "fa-pencil-alt")"></i> 
                                            @(hasCompleted ? "Xem kết quả" : "Làm bài")
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                
                @* Hiển thị điểm danh của chương này *@
                @{
                    var lessonAttendances = Model.Attendances?.Where(a => a.LessonId == lesson.LessonId).OrderByDescending(a => a.StartTime).ToList();
                }
                @if (lessonAttendances != null && lessonAttendances.Any())
                {
                    <div class="mt-4">
                        <h5 class="mb-3"><i class="fas fa-user-check text-success"></i> Điểm danh</h5>
                        <div class="attendance-list">
                            @foreach (var attendance in lessonAttendances)
                            {
                                var totalStudents = Model.ClassStudents?.Count() ?? 0;
                                var presentCount = attendance.AttendanceRecords?.Count(ar => ar.Status == "Present") ?? 0;
                                var attendanceRate = totalStudents > 0 ? (presentCount * 100.0 / totalStudents) : 0;
                                var isClosed = attendance.Status == "Closed";
                                
                                var myRecord = attendance.AttendanceRecords?.FirstOrDefault(ar => ar.StudentId == currentUserId);
                                var myStatus = myRecord?.Status ?? "Absent";
                                
                                <div class="assignment-item mb-3 p-3" style="border: 1px solid #e0e0e0; border-radius: 8px; background: white;">
                                    <div class="d-flex align-items-start gap-3">
                                        <div>
                                            @if (userRole == "Student")
                                            {
                                                <input type="checkbox" @(myStatus == "Present" ? "checked" : "") disabled style="width: 20px; height: 20px; cursor: pointer;" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-user-check" style="font-size: 20px; color: #28a745;"></i>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <h6 class="mb-0">
                                                    @if (userRole == "Teacher" || userRole == "Instructor")
                                                    {
                                                        <a href="@Url.Action("TakeAttendance", "Teacher", new { id = attendance.AttendanceId })" style="color: #0066cc; text-decoration: none;">
                                                            @attendance.Title
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="@Url.Action("StudentAttendance", "Home", new { classId = Model.ClassId })" style="color: #0066cc; text-decoration: none;">
                                                            @attendance.Title
                                                        </a>
                                                    }
                                                    @if (isClosed)
                                                    {
                                                        <span class="badge bg-secondary ms-2">Đã đóng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success ms-2">Đang mở</span>
                                                    }
                                                    @if (userRole == "Student" && myStatus != "Absent")
                                                    {
                                                        @if (myStatus == "Present")
                                                        {
                                                            <span class="badge bg-success ms-2"><i class="fas fa-check"></i> Có mặt</span>
                                                        }
                                                        else if (myStatus == "Late")
                                                        {
                                                            <span class="badge bg-warning ms-2"><i class="fas fa-clock"></i> Muộn</span>
                                                        }
                                                        else if (myStatus == "Excused")
                                                        {
                                                            <span class="badge bg-info ms-2"><i class="fas fa-file-medical"></i> Có phép</span>
                                                        }
                                                    }
                                                </h6>
                                            </div>
                                            <div class="d-flex align-items-center gap-3" style="font-size: 0.9em; color: #666;">
                                                <span><i class="fas fa-clock"></i> @attendance.StartTime.ToString("dd/MM/yyyy HH:mm") - @attendance.EndTime.ToString("dd/MM/yyyy HH:mm")</span>
                                                @if (userRole == "Teacher" || userRole == "Instructor")
                                                {
                                                    <span><i class="fas fa-users"></i> @presentCount/@totalStudents (@attendanceRate.ToString("F1")%)</span>
                                                    @if (attendance.AllowCodeAttendance && !string.IsNullOrEmpty(attendance.AttendanceCode))
                                                    {
                                                        <span><i class="fas fa-key"></i> Mã: <strong>@attendance.AttendanceCode</strong></span>
                                                    }
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(attendance.Description))
                                            {
                                                <p class="mt-2 mb-0" style="font-size: 0.9em; color: #555;">@attendance.Description</p>
                                            }
                                        </div>
                                        <div>
                                            @if (userRole == "Teacher" || userRole == "Instructor")
                                            {
                                                <a href="@Url.Action("ShowAttendanceQR", "Teacher", new { id = attendance.AttendanceId })" 
                                                   class="btn btn-sm btn-success me-1">
                                                    <i class="fas fa-qrcode"></i> QR Code
                                                </a>
                                                <a href="@Url.Action("TakeAttendance", "Teacher", new { id = attendance.AttendanceId })" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="fas fa-list"></i> Danh sách
                                                </a>
                                            }
                                            @if (userRole == "Student" && !isClosed && myStatus != "Present")
                                            {
                                                <button onclick="openAttendanceCodeModal(@attendance.AttendanceId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(attendance.Title))')" 
                                                        class="btn btn-sm btn-primary">
                                                    <i class="fas fa-keyboard"></i> Nhập mã
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                
                @* Menu quản lý khóa học cho từng chương *@
                @if (userRole == "Teacher" || userRole == "Instructor")
                {
                    <div class="mt-4 border-top pt-3 edit-control">
                        <button class="btn btn-outline-primary btn-sm" type="button" onclick="openLessonManagementModal(@lesson.LessonId)">
                            <i class="fas fa-cog"></i> Quản lý khóa học
                        </button>
                    </div>
                }
            </div>
        </div>
    }
}
    </div> <!-- End mission-content -->
</section> <!-- End mission-section -->

