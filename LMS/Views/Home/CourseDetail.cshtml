@section Scripts {
<!-- CKEditor 5 CDN -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>
<script>
    // ============ CKEditor Instance ============
    let lessonContentEditorInstance = null;

    // ============ Teacher Dropdown Menu ============
    function toggleTeacherDropdown(event) {
        event.stopPropagation();
        const dropdown = document.getElementById('teacherDropdownMenu');
        dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('teacherDropdownMenu');
        const button = document.getElementById('teacherActionsDropdown');
        
        if (dropdown && button && !button.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
        }
    });

    // Export to Excel function
    function exportToExcel() {
        window.location.href = '@Url.Action("ExportStudentsToExcel", "Teacher", new { classId = Model.ClassId })';
    }

    // ============ Toggle Edit Mode ============
    function toggleEditMode() {
        const body = document.body;
        const isEditMode = body.classList.toggle('edit-mode');
        const buttonText = document.getElementById('editModeButtonText');
        
        if (isEditMode) {
            buttonText.textContent = 'Tắt chế độ chỉnh sửa';
            // Close dropdown
            document.getElementById('teacherDropdownMenu').style.display = 'none';
        } else {
            buttonText.textContent = 'Bật chế độ chỉnh sửa';
        }
    }

    // ============ Chapter Toggle ============
    function toggleChapter(header) {
        const content = header.nextElementSibling;
        const icon = header.querySelector('.expand-icon');
        
        if (content.style.display === "none") {
            content.style.display = "block";
            icon.classList.remove('rotated');
        } else {
            content.style.display = "none";
            icon.classList.add('rotated');
        }
    }

    // Thông báo khi hoàn thành bài học
    document.querySelectorAll('.complete-check').forEach(check => {
        check.addEventListener('change', function() {
            if(this.checked) {
                alert("Chúc mừng bạn đã hoàn thành chương này!");
            }
        });
    });

    // Video Modal Functions
    function convertToEmbedUrl(videoUrl) {
        // YouTube
        if (videoUrl.includes('youtube.com/watch?v=')) {
            const videoId = videoUrl.split('v=')[1].split('&')[0];
            return `https://www.youtube.com/embed/${videoId}`;
        }
        if (videoUrl.includes('youtu.be/')) {
            const videoId = videoUrl.split('youtu.be/')[1].split('?')[0];
            return `https://www.youtube.com/embed/${videoId}`;
        }
        
        // Vimeo
        if (videoUrl.includes('vimeo.com/')) {
            const videoId = videoUrl.split('vimeo.com/')[1].split('?')[0];
            return `https://player.vimeo.com/video/${videoId}`;
        }
        
        // Dailymotion
        if (videoUrl.includes('dailymotion.com/video/')) {
            const videoId = videoUrl.split('video/')[1].split('?')[0];
            return `https://www.dailymotion.com/embed/video/${videoId}`;
        }
        
        // Google Drive
        if (videoUrl.includes('drive.google.com/file/d/')) {
            const fileId = videoUrl.split('/d/')[1].split('/')[0];
            return `https://drive.google.com/file/d/${fileId}/preview`;
        }
        
        // Nếu không match format nào, trả về URL gốc
        return videoUrl;
    }

    function openVideoModal(title, videoUrl) {
        const modal = document.getElementById('videoModal');
        const iframe = document.getElementById('videoModalIframe');
        const modalTitle = document.getElementById('videoModalTitle');
        
        // Convert URL to embed format
        const embedUrl = convertToEmbedUrl(videoUrl);
        
        modalTitle.textContent = title;
        iframe.src = embedUrl;
        modal.style.display = 'block';
        
        // Prevent body scroll when modal is open
        document.body.style.overflow = 'hidden';
    }

    function closeVideoModal() {
        const modal = document.getElementById('videoModal');
        const iframe = document.getElementById('videoModalIframe');
        
        // Stop video by clearing src
        iframe.src = '';
        modal.style.display = 'none';
        
        // Restore body scroll
        document.body.style.overflow = 'auto';
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
        const modal = document.getElementById('videoModal');
        if (event.target == modal) {
            closeVideoModal();
        }
    }

    // Close modal on ESC key
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeVideoModal();
        }
    });

    // Delete assignment function
    function deleteAssignment(assignmentId, assignmentTitle) {
        if (confirm(`Bạn có chắc chắn muốn xóa bài tập "${assignmentTitle}"?\n\nLưu ý: Tất cả bài nộp của sinh viên sẽ bị xóa theo!`)) {
            fetch('@Url.Action("DeleteAssignment", "Teacher")?id=' + assignmentId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                alert('Có lỗi xảy ra: ' + error);
            });
        }
    }

    // Delete exam function
    function deleteExam(examId, examTitle) {
        if (confirm(`Bạn có chắc chắn muốn xóa bài kiểm tra "${examTitle}"?\n\nLưu ý: Tất cả kết quả thi của sinh viên sẽ bị xóa theo!`)) {
            fetch('@Url.Action("DeleteExam", "Teacher")?id=' + examId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                alert('Có lỗi xảy ra: ' + error);
            });
        }
    }

    // Show modal for adding slide
    function showAddSlideModal() {
        document.getElementById('addSlideModal').style.display = 'block';
        document.getElementById('sectionSelectDiv').style.display = 'block';
        document.getElementById('targetLessonId').value = '';
        document.getElementById('sectionSelect').value = 'new';
        toggleSectionInput(); // Set initial state
    }
    
    // Show modal for adding slide to specific section
    function showAddSlideModalForSection(lessonId) {
        document.getElementById('addSlideModal').style.display = 'block';
        document.getElementById('sectionSelectDiv').style.display = 'none';
        document.getElementById('newSectionTitleDiv').style.display = 'none';
        document.getElementById('targetLessonId').value = lessonId;
    }
    
    // Show modal for adding video to specific section
    function showAddVideoModalForSection(lessonId) {
        document.getElementById('videoLessonId').value = lessonId;
        document.getElementById('videoUrl').value = '';
        document.getElementById('addVideoModal').style.display = 'block';
    }

    // Close modal for adding slide
    function closeAddSlideModal() {
        document.getElementById('addSlideModal').style.display = 'none';
        document.getElementById('addSlideForm').reset();
    }

    // Toggle section title input based on selection
    function toggleSectionInput() {
        var select = document.getElementById('sectionSelect');
        var newSectionDiv = document.getElementById('newSectionTitleDiv');
        
        if (select.value === 'new') {
            newSectionDiv.style.display = 'block';
        } else {
            newSectionDiv.style.display = 'none';
        }
    }

    // Show modal for creating section
    function showCreateSectionModal() {
        document.getElementById('createSectionModal').style.display = 'block';
        // Reset selected icon
        document.getElementById('selectedIcon').value = '';
        document.querySelectorAll('.icon-picker-item').forEach(btn => {
            btn.style.borderColor = '#ddd';
            btn.style.background = 'white';
        });
    }

    // Close modal for creating section
    function closeCreateSectionModal() {
