    // Lesson Content Edit Functions
    function showEditLessonContentModal(lessonId, lessonTitle) {
        document.getElementById('editContentLessonId').value = lessonId;
        document.getElementById('editContentLessonTitle').innerText = lessonTitle;
        
        // Fetch current content
        fetch('@Url.Action("GetLessonContent", "Teacher")?lessonId=' + lessonId)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Initialize CKEditor if not already initialized
                    if (!lessonContentEditorInstance) {
                        ClassicEditor
                            .create(document.querySelector('#lessonContentEditor'), {
                                toolbar: {
                                    items: [
                                        'heading', '|',
                                        'bold', 'italic', 'underline', 'strikethrough', '|',
                                        'fontSize', 'fontColor', 'fontBackgroundColor', '|',
                                        'link', 'bulletedList', 'numberedList', '|',
                                        'alignment', '|',
                                        'indent', 'outdent', '|',
                                        'insertTable', 'blockQuote', 'horizontalLine', '|',
                                        'undo', 'redo'
                                    ]
                                },
                                language: 'vi',
                                heading: {
                                    options: [
                                        { model: 'paragraph', title: 'Đoạn văn', class: 'ck-heading_paragraph' },
                                        { model: 'heading1', view: 'h1', title: 'Tiêu đề 1', class: 'ck-heading_heading1' },
                                        { model: 'heading2', view: 'h2', title: 'Tiêu đề 2', class: 'ck-heading_heading2' },
                                        { model: 'heading3', view: 'h3', title: 'Tiêu đề 3', class: 'ck-heading_heading3' }
                                    ]
                                }
                            })
                            .then(editor => {
                                lessonContentEditorInstance = editor;
                                editor.setData(data.content || '');
                                document.getElementById('editLessonContentModal').style.display = 'block';
                                document.body.style.overflow = 'hidden';
                            })
                            .catch(error => {
                                console.error('CKEditor initialization error:', error);
                                alert('Lỗi khởi tạo trình soạn thảo!');
                            });
                    } else {
                        lessonContentEditorInstance.setData(data.content || '');
                        document.getElementById('editLessonContentModal').style.display = 'block';
                        document.body.style.overflow = 'hidden';
                    }
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(error => {
                alert('Có lỗi xảy ra khi tải nội dung: ' + error);
            });
    }

    function closeLessonContentModal() {
        document.getElementById('editLessonContentModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }

    function submitLessonContent() {
        const lessonId = document.getElementById('editContentLessonId').value;
        
        if (!lessonContentEditorInstance) {
            alert('Trình soạn thảo chưa được khởi tạo!');
            return;
        }

        const content = lessonContentEditorInstance.getData().trim();

        if (!content) {
            alert('Vui lòng nhập nội dung cho chương!');
            return;
        }

        const formData = new FormData();
        formData.append('lessonId', lessonId);
        formData.append('content', content);

        fetch('@Url.Action("UpdateLessonContent", "Teacher")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                closeLessonContentModal();
                location.reload(); // Reload để hiển thị nội dung mới
            } else {
                alert('Lỗi: ' + data.message);
            }
        })
        .catch(error => {
            alert('Có lỗi xảy ra: ' + error);
        });
    }

