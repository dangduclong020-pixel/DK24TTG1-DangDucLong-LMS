            }
        })
        .catch(error => {
            alert('Có lỗi xảy ra: ' + error);
        });
    }

    // ============ Thêm video bài giảng ============
    function openAddVideoModal() {
        closeLessonManagementModal();
        
        const lessonId = currentLessonIdForVideo;
        if (!lessonId) {
            alert('Không tìm thấy thông tin chương!');
            return;
        }
        
        // Lấy tiêu đề chương từ DOM
        const lessonTitle = document.querySelector(`[data-lesson-id="${lessonId}"]`)?.innerText || 'Chương này';
        
        document.getElementById('videoLessonId').value = lessonId;
        document.getElementById('videoLessonTitle').innerText = lessonTitle;
        document.getElementById('videoUrl').value = '';
        document.getElementById('addVideoModal').style.display = 'block';
        document.body.style.overflow = 'hidden';
    }

    function closeAddVideoModal() {
        document.getElementById('addVideoModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }

    function submitVideoUrl() {
        const lessonId = document.getElementById('videoLessonId').value;
        const videoUrl = document.getElementById('videoUrl').value.trim();

        if (!videoUrl) {
            alert('Vui lòng nhập link video!');
            return;
        }

        // Kiểm tra URL hợp lệ
        try {
            new URL(videoUrl);
        } catch {
            alert('Link video không hợp lệ!');
            return;
        }

        fetch('@Url.Action("AddLessonVideo", "Teacher")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                lessonId: lessonId,
                videoUrl: videoUrl
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message || 'Thêm video thành công!');
                closeAddVideoModal();
                location.reload();
            } else {
                alert('Lỗi: ' + (data.message || 'Không thể thêm video'));
            }
        })
        .catch(error => {
            alert('Có lỗi xảy ra: ' + error);
        });
    }

    // ============ Icon Picker Handlers ============
    document.addEventListener('DOMContentLoaded', function() {
        // Xử lý icon picker cho modal tạo section
        document.querySelectorAll('.icon-picker-item').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Reset all buttons
                document.querySelectorAll('.icon-picker-item').forEach(function(b) {
                    b.style.borderColor = '#ddd';
                    b.style.background = 'white';
                });
                
                // Highlight selected button
                this.style.borderColor = '#0d6efd';
                this.style.background = '#e7f1ff';
                
                // Save selected icon
                var iconClass = this.getAttribute('data-icon');
                document.getElementById('selectedIcon').value = iconClass;
            });
        });

        // Xử lý icon picker cho modal sửa section
        document.querySelectorAll('.icon-picker-item-edit').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Reset all buttons
                document.querySelectorAll('.icon-picker-item-edit').forEach(function(b) {
                    b.style.borderColor = '#ddd';
                    b.style.background = 'white';
                });
                
                // Highlight selected button
                this.style.borderColor = '#0d6efd';
                this.style.background = '#e7f1ff';
                
                // Save selected icon
                var iconClass = this.getAttribute('data-icon');
                document.getElementById('selectedIconEdit').value = iconClass;
            });
        });

        // CSS cho hover effect
        var style = document.createElement('style');
        style.textContent = `
            .icon-picker-item:hover,
            .icon-picker-item-edit:hover {
                border-color: #0d6efd !important;
                background: #f8f9fa !important;
                transform: scale(1.05);
            }
        `;
        document.head.appendChild(style);
    });
</script>
}