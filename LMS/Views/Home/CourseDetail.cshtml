    // Submit create section
    function submitCreateSection() {
        var sectionTitle = document.getElementById('sectionTitle').value.trim();
        var selectedIcon = document.getElementById('selectedIcon').value;

        // Validate
        if (!sectionTitle) {
            alert('Vui lòng nhập tiêu đề cho section!');
            return;
        }

        // Nếu có icon được chọn, thêm icon vào đầu title
        var fullTitle = sectionTitle;
        if (selectedIcon) {
            fullTitle = '<i class="' + selectedIcon + '"></i> ' + sectionTitle;
        }

        // Tạo section mới
        var formData = new FormData();
        formData.append('classId', '@Model.ClassId');
        formData.append('sectionTitle', fullTitle);

        fetch('@Url.Action("CreateSection", "Teacher")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeCreateSectionModal();
                
                // Kiểm tra xem có cần chuyển hướng đến trang quản lý attendance không
                if (window.shouldRedirectToAttendance) {
                    window.shouldRedirectToAttendance = false; // Reset flag
                    window.location.href = '@Url.Action("ManageAttendance", "Teacher")' + '?lessonId=' + data.lessonId;
                } else {
                    alert(data.message);
                    location.reload(); // Reload trang để hiển thị section mới
                }
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            alert('Có lỗi xảy ra: ' + error);
        });
    }

