    // Submit slide
    function submitSlide() {
        var targetLessonId = document.getElementById('targetLessonId').value;
        var sectionSelect = document.getElementById('sectionSelect').value;
        var sectionTitle = document.getElementById('sectionTitle').value.trim();
        var title = document.getElementById('slideTitle').value.trim();
        var url = document.getElementById('slideUrl').value.trim();

        if (!title) {
            alert('Vui lòng nhập tiêu đề cho slide!');
            return;
        }

        if (!url) {
            alert('Vui lòng nhập URL slide bài giảng!');
            return;
        }

        // Create FormData
        var formData = new FormData();
        formData.append('classId', '@Model.ClassId');
        
        // Nếu có targetLessonId (thêm từ section cụ thể)
        if (targetLessonId) {
            formData.append('lessonId', targetLessonId);
        } else {
            // Nếu chọn section có sẵn
            if (sectionSelect !== 'new') {
                formData.append('lessonId', sectionSelect);
            } else {
                formData.append('lessonId', '');
                formData.append('sectionTitle', sectionTitle || 'Tài liệu chung');
            }
        }
        
        formData.append('url', url);
        formData.append('title', title);

        // Submit via AJAX
        fetch('@Url.Action("AddSlide", "Teacher")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload(); // Reload trang để hiển thị section mới
            } else {
                alert(data.message);
            }
        })
        .catch(error => {
            alert('Có lỗi xảy ra: ' + error);
        });
    }

